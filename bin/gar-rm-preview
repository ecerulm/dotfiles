#!/usr/bin/env zsh
# Usage: gar-rm-preview LOCATION-docker.pkg.dev/PROJECT/REPO/IMAGE[/subpath]
#
# Deletion-oriented Artifact Registry package summary for fzf preview
# panes. Unlike bin/gar-preview (which is browse-oriented and lists the
# 10 newest tags), this answers "what exactly am I about to destroy?":
#
#   version count broken down by deletability, total size on disk,
#   newest/oldest version dates, tag count, package metadata
#   (create/update time, annotations), and a sample of the newest
#   tagged versions.
#
# The version count matters twice over: it is the blast radius, and it
# decides how many 1000-version delete batches rlm-gar-rm will need.
#
# The breakdown splits untagged versions into the per-arch members of a
# multi-arch index and true orphans, because only the latter are safe to
# remove — deleting a member breaks the tagged image that references it.
# That attribution is expensive (one registry GET per index) so it is only
# ever READ from the cache rlm-gar-version-rm maintains, never fetched
# here; see the GAR_RM_CHILDREN/GAR_RM_RESOLVED handling below.
emulate -L zsh
set -o pipefail

_gar_rm_preview_main() {
  local image=$1
  if [[ -z $image ]]; then
    print -u2 "gar-rm-preview: usage: gar-rm-preview IMAGE_PATH"
    return 1
  fi

  local loc_host proj repo pkg_path location_slug pkg_encoded console_url
  loc_host=${image%%/*}
  proj=$(printf '%s' "$image" | cut -d/ -f2)
  repo=$(printf '%s' "$image" | cut -d/ -f3)
  pkg_path=$(printf '%s' "$image" | cut -d/ -f4-)
  location_slug=${loc_host%-docker.pkg.dev}
  pkg_encoded=${pkg_path//\//%2F}
  console_url="https://console.cloud.google.com/artifacts/docker/${proj}/${location_slug}/${repo}/${pkg_encoded}?project=${proj}"

  local red=$'\e[31m' yellow=$'\e[33m' bold=$'\e[1m' reset=$'\e[0m'

  printf '%sWILL DELETE%s  %s\n' "$red$bold" "$reset" "$image"
  printf '\n'
  printf 'Package:    %s\n' "$pkg_path"
  printf 'Project:    %s\n' "$proj"
  printf 'Repository: %s\n' "$repo"
  # Location gets its own line: `europe` (multi-region) and `europe-west1`
  # (single region) are different locations holding different repos, and
  # the distinction is invisible when it is glued onto the repo name.
  case $location_slug in
    europe|us|asia) printf 'Location:   %s  (multi-region)\n' "$location_slug" ;;
    *)              printf 'Location:   %s\n' "$location_slug" ;;
  esac
  printf 'Console:    '
  printf '\e]8;;%s\e\\Open in GCP console\e]8;;\e\\' "$console_url"; printf '\n'
  printf '\n'

  local token
  token=$(gcloud auth print-access-token 2>/dev/null)
  if [[ -z $token ]]; then
    printf '%sCANNOT INSPECT%s  no gcloud access token\n' "$red$bold" "$reset"
    printf 'Run: gcloud auth login\n'
    return 0
  fi

  # Package-level metadata (createTime/updateTime/annotations) comes from
  # the packages.get REST endpoint; `gcloud artifacts packages describe`
  # does not expose annotations. A permission error here is reported
  # rather than skipped — on a delete tool, a silently-missing metadata
  # block is indistinguishable from a package that genuinely has none.
  local pkg_api_encoded pkg_json
  pkg_api_encoded=${pkg_path//\//%2F}
  pkg_json=$(curl -sS \
    -H "Authorization: Bearer ${token}" \
    "https://artifactregistry.googleapis.com/v1/projects/${proj}/locations/${location_slug}/repositories/${repo}/packages/${pkg_api_encoded}" \
    2>/dev/null)
  if [[ -n $pkg_json ]] && printf '%s' "$pkg_json" | jq -e '.error' >/dev/null 2>&1; then
    local api_status api_msg
    api_status=$(printf '%s' "$pkg_json" | jq -r '.error.status // "ERROR"')
    api_msg=$(printf '%s' "$pkg_json" | jq -r '.error.message' | cut -c1-160)
    printf '%sMetadata:   %s%s\n' "$yellow" "$api_status" "$reset"
    printf '            %s\n' "$api_msg"
    printf '\n'
  elif [[ -n $pkg_json ]] && printf '%s' "$pkg_json" | jq -e '.name' >/dev/null 2>&1; then
    printf '%s' "$pkg_json" | jq -r '
      (if .createTime then "Created:    " + (.createTime | sub("\\..*";"") | sub("T";" ")) + " UTC" else empty end),
      (if .updateTime then "Updated:    " + (.updateTime | sub("\\..*";"") | sub("T";" ")) + " UTC" else empty end),
      (if (.annotations // {} | length) > 0 then
         "Annotations:", (.annotations | to_entries[] | "  " + .key + " = " + (.value | tostring))
       else empty end)
    ' 2>/dev/null
    printf '\n'
  fi

  # Full version list. --limit is deliberately absent: the count is the
  # headline number here and an undercount would understate the blast
  # radius (and the number of delete batches needed).
  #
  # stderr is captured, not discarded: an auth or permission failure must
  # never render as "no versions found", which reads as "this package is
  # empty, safe to delete".
  local json err rc
  err=$(mktemp) || err=/dev/null
  json=$(gcloud artifacts docker images list "$image" \
           --include-tags \
           --sort-by='~UPDATE_TIME' \
           --format=json \
           --project="$proj" 2>"$err")
  rc=$?

  if (( rc != 0 )); then
    printf '%sCANNOT LIST VERSIONS%s  (exit %d)\n' "$red$bold" "$reset" "$rc"
    if [[ -s $err ]]; then
      grep -v '^$' "$err" | head -6 | sed 's/^/  /'
    fi
    printf '\n%sVersion count unknown — do not assume this package is empty.%s\n' "$yellow" "$reset"
    [[ $err != /dev/null ]] && rm -f "$err"
    return 0
  fi
  [[ $err != /dev/null ]] && rm -f "$err"

  if [[ -z $json || $json == '[]' ]]; then
    printf '(no versions found — package is empty or already deleted)\n'
    return 0
  fi

  # Index->child attribution, when rlm-gar-version-rm has already resolved
  # it for this package. Splitting "untagged" into orphans vs members needs
  # one registry GET per multi-arch index (see _rlm-gar-index-children), so
  # it is never fetched here: this preview re-runs on every keystroke, and a
  # package can hold hundreds of indexes. We read the cache if it exists and
  # otherwise report the untagged versions as unclassified — an honest
  # "unresolved" is the only safe rendering on a delete tool, since guessing
  # members are orphans invites deleting them.
  #
  # Cache layout and key are owned by _rlm-gar-version-cache; the key is a
  # plain md5 of the image path.
  local child_map='' resolved_map='' cache_key='' cache_dir=''
  cache_key=$(printf '%s' "$image" | md5 2>/dev/null) \
    || cache_key=$(printf '%s' "$image" | md5sum 2>/dev/null | cut -d' ' -f1)
  if [[ -n $cache_key ]]; then
    cache_dir="$HOME/.cache/gar-version/${cache_key}"
    [[ -s "${cache_dir}/children.tsv" ]] && child_map="${cache_dir}/children.tsv"
    [[ -s "${cache_dir}/resolved.txt" ]] && resolved_map="${cache_dir}/resolved.txt"
  fi

  printf '%s' "$json" \
    | GAR_RM_CHILDREN="$child_map" GAR_RM_RESOLVED="$resolved_map" python3 -c '
import sys, json, os, re
from datetime import datetime, timezone

def human_size(b):
    if not b:
        return "0 B"
    b = float(b)
    for unit in ("B","KB","MB","GB"):
        if b < 1024:
            return f"{b:.0f} {unit}"
        b /= 1024
    return f"{b:.1f} TB"

def parse(ts):
    if not ts:
        return None
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except Exception:
        return None

def human_time(dt):
    if dt is None:
        return "?"
    diff = int((datetime.now(timezone.utc) - dt).total_seconds())
    days = diff // 86400
    if diff < 3600:
        rel = f"{diff // 60}m ago"
    elif diff < 86400:
        rel = f"{diff // 3600}h ago"
    elif days < 365:
        rel = f"{days}d ago"
    else:
        # Compound y+d past a year: "1y20d ago" reads as "just over a
        # year" without mental arithmetic, where "384d ago" does not.
        years, rem = divmod(days, 365)
        rel = f"{years}y{rem}d ago" if rem else f"{years}y ago"
    stamp = dt.strftime("%Y-%m-%d %H:%M")
    return f"{stamp} UTC  ({rel})"

data = json.load(sys.stdin)

# child digest -> parent digest, as resolved by rlm-gar-version-rm. Absent
# when this package has not been opened in the version picker yet.
children = set()
cpath = os.environ.get("GAR_RM_CHILDREN") or ""
if cpath and os.path.exists(cpath):
    with open(cpath) as fh:
        for raw in fh:
            parts = raw.rstrip("\n").split("\t")
            if len(parts) >= 2 and parts[0]:
                children.add(parts[0])

# Indexes whose manifest has already been fetched. Rows are `<digest>` or
# `<digest>\tempty` (the childless marker) — match on the digest column.
resolved = set()
rpath = os.environ.get("GAR_RM_RESOLVED") or ""
if rpath and os.path.exists(rpath):
    with open(rpath) as fh:
        for raw in fh:
            d = raw.rstrip("\n").split("\t")[0]
            if d:
                resolved.add(d)

listing_indexes = set()
total_bytes = 0
tag_total = 0
tagged = 0
untagged_index = 0
referenced = 0
orphan = 0
times = []
for e in data:
    meta = e.get("metadata") or {}
    sb = meta.get("imageSizeBytes") or e.get("imageSizeBytes")
    # Multi-arch index entries report the sum of their children under a
    # separate digest, so summing every entry double-counts nothing here:
    # child manifests are listed as their own entries by images list.
    if sb:
        total_bytes += int(sb)
    tags = e.get("tags") or []
    tag_total += len(tags)
    digest = e.get("version") or ""
    is_index = bool(re.search("index|list", meta.get("mediaType") or ""))
    if is_index and digest:
        listing_indexes.add(digest)
    if tags:
        tagged += 1
    elif is_index:
        # An untagged index is not a leftover: it owns the members listed
        # under it, and deleting it strands them.
        untagged_index += 1
    elif digest in children:
        referenced += 1
    else:
        orphan += 1
    dt = parse(e.get("updateTime") or e.get("uploadTime") or e.get("createTime"))
    if dt:
        times.append(dt)

n = len(data)
batches = (n + 999) // 1000
untagged = n - tagged

# The orphan count is only trustworthy when EVERY index in the current
# listing has been resolved. A cache resolved before newer indexes were
# pushed still returns rows, so a bare "children.tsv exists" test reports
# their members as unreferenced — measured at 24 false orphans out of 68
# members on catalogue_export. On a delete tool that is the dangerous
# direction: a live member of a tagged multi-arch image rendered as safe
# to remove. Partial coverage therefore degrades to "unresolved".
unresolved_indexes = listing_indexes - resolved
# A package with no indexes at all needs no attribution: every untagged
# version is necessarily an orphan, so the split is known without any
# cache. Requiring a non-empty children.tsv here would leave those
# packages permanently reporting "unresolved" — the exact case where the
# orphan count is both certain and most useful.
have_attribution = not unresolved_indexes and (bool(children) or not listing_indexes)

print(f"Versions:   {n}")
print(f"  tagged:            {tagged}")
if untagged_index:
    print(f"  untagged index:    {untagged_index}   (owns members below)")
if have_attribution:
    # In a package with no multi-arch images at all, "index members: 0" is
    # noise — every untagged version is simply untagged.
    if listing_indexes:
        print(f"  index members:     {referenced}   (untagged, referenced by an index)")
        print(f"  unreferenced:      {orphan}   (untagged, nothing points at them)")
    elif orphan:
        print(f"  untagged:          {orphan}   (nothing points at them)")
elif untagged - untagged_index > 0:
    # Never guess: without full attribution these could be members of a
    # tagged multi-arch image, and deleting one silently breaks it.
    if unresolved_indexes and children:
        why = f"{len(unresolved_indexes)} index(es) not yet resolved"
    else:
        why = "not yet resolved"
    print(f"  untagged:          {untagged - untagged_index}   "
          f"(members vs orphans {why} — open in gar-version-rm)")
print(f"Tags:       {tag_total}")
print(f"Total size: {human_size(total_bytes)}")
if times:
    print(f"Newest:     {human_time(max(times))}")
    print(f"Oldest:     {human_time(min(times))}")
if batches > 1:
    print(f"Batches:    {batches}  (1000-version delete cap)")
print()

shown = [e for e in data if e.get("tags")][:10]
if shown:
    hdr = "NEWEST TAGGED VERSIONS"
    siz = "SIZE"
    print(f"{hdr:<44}  {siz:>10}  UPDATED")
    d44, d10, d16 = "-" * 44, "-" * 10, "-" * 16
    print(f"{d44}  {d10}  {d16}")
    for e in shown:
        meta = e.get("metadata") or {}
        sb = meta.get("imageSizeBytes") or e.get("imageSizeBytes")
        tag_str = ", ".join(e.get("tags") or [])
        if len(tag_str) > 42:
            tag_str = tag_str[:39] + "..."
        dt = parse(e.get("updateTime") or e.get("uploadTime"))
        when = dt.strftime("%Y-%m-%d %H:%M") if dt else "?"
        print(f"{tag_str:<44}  {human_size(sb):>10}  {when}")
    remaining = tagged - len(shown)
    if remaining > 0:
        print(f"... and {remaining} more tagged version(s)")
else:
    print("(all versions are untagged)")
'
}

_gar_rm_preview_main "$@"
