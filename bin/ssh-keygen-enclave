#!/bin/sh
# gpg.ssh.program wrapper.
#
# 1. Forces the macOS Secure Enclave SK provider.
# 2. Fails LOUDLY when the enclave hands back an empty / unverifiable signature.
#
# Why 2 is needed: when Touch ID is unavailable (lid closed / clamshell mode,
# some remote/SSH contexts) Apple's ssh-keychain.dylib does NOT return an error
# to ssh-keygen -- it returns "success" with an all-zero ECDSA (r,s). ssh-keygen
# wraps that in a well-formed "-----BEGIN SSH SIGNATURE-----" block and exits 0.
# git only checks the signer's exit status and that the .sig file parses, so it
# happily records a commit whose signature can never verify.
#
# This wrapper re-verifies the signature it just produced with the *public* key
# (pure crypto, no Touch ID needed) and exits non-zero on failure, which makes
# `git commit` abort with "gpg failed to sign the data" instead.

export SSH_SK_PROVIDER=/usr/lib/ssh-keychain.dylib
SSH_KEYGEN=/usr/bin/ssh-keygen

"$SSH_KEYGEN" "$@"
st=$?
[ "$st" -ne 0 ] && exit "$st"

# Detect `-Y sign`, and capture `-f <key>`; git puts the buffer file last.
mode="" key="" prev="" last=""
for a in "$@"; do
	[ "$prev" = "-Y" ] && [ "$a" = "sign" ] && mode="sign"
	[ "$prev" = "-f" ] && key="$a"
	prev="$a"
	last="$a"
done
[ "$mode" = "sign" ] || exit 0

buffer="$last"
sig="${buffer}.sig"
if [ ! -s "$sig" ]; then
	echo "ssh-keygen-enclave: signer produced no signature file" >&2
	exit 1
fi

allowed="$(mktemp -t sshkeygen_enclave)" || exit 1
trap 'rm -f "$allowed"' EXIT
printf 'selfcheck namespaces="git" %s\n' "$(cat "$key")" > "$allowed"

if ! "$SSH_KEYGEN" -Y verify -f "$allowed" -I selfcheck -n git -s "$sig" \
		< "$buffer" >/dev/null 2>&1; then
	rm -f "$sig"
	echo "ssh-keygen-enclave: Secure Enclave returned an unverifiable signature." >&2
	echo "  Touch ID is probably unavailable (lid closed / clamshell). Commit aborted." >&2
	echo "  Open the lid so Touch ID works, then retry." >&2
	exit 1
fi
exit 0
