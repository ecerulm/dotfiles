emulate -L zsh
setopt LOCAL_OPTIONS NO_MONITOR NO_NOTIFY
set -o pipefail

# ---------------------------------------------------------------------------
# Precondition checks
# ---------------------------------------------------------------------------

for _cmd in bq fzf jq; do
  if ! command -v "$_cmd" >/dev/null 2>&1; then
    print -u2 "bq-archive: '$_cmd' not found in PATH"
    return 1
  fi
done
unset _cmd

if [[ -z $BQ_SEARCH_PATH ]]; then
  print -u2 "bq-archive: BQ_SEARCH_PATH must be set (same as bq-open)"
  print -u2 "Set BQ_SEARCH_PATH to a colon-separated list of GCP projects, e.g.:"
  print -u2 "  export BQ_SEARCH_PATH=my-project-prod:my-project-dev"
  return 1
fi

# ---------------------------------------------------------------------------
# Shared cache + history wiring. All five rlm-bq-* / rlm-sandbox-bq-*
# commands share one cache pair (~/.cache/bq-open/<md5>.txt and
# -sandbox.txt) and one pooled history TSV (~/.cache/bq-open/history.tsv)
# via these helpers. See zsh/AGENTS.md "Current internal helpers".
# ---------------------------------------------------------------------------

autoload -Uz _rlm-bq-cache _rlm-bq-history _rlm-bq-dead-refs-gc _rlm-bq-refresh-sentinels

# Garbage-collect any refs that bq-preview marked as dead on a previous
# run. No-op when ~/.cache/bq-open/dead-refs.txt is missing/empty.
_rlm-bq-dead-refs-gc

local key cache sandbox
eval "$(_rlm-bq-cache paths)" || return 1

# Lazy refresh: fetch on first run if no cache exists yet for the
# current scope.
if [[ ! -f $cache ]]; then
  _rlm-bq-cache refresh --main-only || return 1
fi
if [[ -n $SANDBOX_BQ_PROJECT && ! -f $sandbox ]]; then
  _rlm-bq-cache refresh --sandbox-only
fi

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

local lookback_days="${BQ_ARCHIVE_LOOKBACK_DAYS:-7}"

local -a ignored_principals
if [[ -n $BQ_ARCHIVE_IGNORED_PRINCIPALS ]]; then
  ignored_principals=(${(s[:])BQ_ARCHIVE_IGNORED_PRINCIPALS})
else
  ignored_principals=(
    "composer@storytel-data-platform-prod.iam.gserviceaccount.com"
    "data-build-tool@storytel-data-platform-prod.iam.gserviceaccount.com"
  )
fi

# ---------------------------------------------------------------------------
# fzf multi-select — single-column layout to avoid leading whitespace.
# Each line is just "BQ_REF" (uncolored) or "PURPLE+BQ_REF+RESET" (sandbox).
# Sandbox classification on readback: did stripping ANSI shorten the line?
# Ordering: history (most recent first) → sandbox cache → remaining
# non-sandbox cache (deduped against history). awk drops any line whose
# ANSI-stripped ref has already been seen.
# ---------------------------------------------------------------------------

local PURPLE=$'\033[35m'
local RESET=$'\033[0m'

# REFRESH sentinels — single-column layout (no --tab). Selecting either
# line refreshes the relevant cache and re-invokes rlm-bq-archive.
# Shared helper; see zsh/AGENTS.md.
local refresh_sentinel refresh_sandbox_sentinel
refresh_sentinel=$(_rlm-bq-refresh-sentinels emit-main)
refresh_sandbox_sentinel=$(_rlm-bq-refresh-sentinels emit-sandbox)

# Build the set of bq_refs that exist in the current cache scope. Pooled
# history may contain entries from other scopes (different
# BQ_SEARCH_PATH); we suppress those so the picker never suggests a ref
# the user can't actually operate on from here.
local -A in_scope
local _ref
while IFS= read -r _ref; do
  [[ -n $_ref ]] && in_scope[$_ref]=1
done < <(_rlm-bq-cache read --both)

# Pooled-history lines (newest first). Format: <epoch>\t<command>\t<ref>\t<flags>.
# Emit bare ref for non-sandbox; PURPLE+ref+RESET for sandbox-flagged
# entries. Filter out cross-scope refs via in_scope.
_bq_archive_history_lines() {
  local ts cmd ref flags
  while IFS=$'\t' read -r ts cmd ref flags; do
    [[ -z $ref ]] && continue
    [[ -z ${in_scope[$ref]:-} ]] && continue
    if [[ ,${flags}, == *,sandbox,* ]]; then
      printf '%s%s%s\n' "$PURPLE" "$ref" "$RESET"
    else
      printf '%s\n' "$ref"
    fi
  done < <(_rlm-bq-history read)
}

# Sandbox cache entries (each wrapped in PURPLE/RESET).
_bq_archive_sandbox_lines() {
  local line
  while IFS= read -r line; do
    [[ -n $line ]] && printf '%s%s%s\n' "$PURPLE" "$line" "$RESET"
  done < <(_rlm-bq-cache read --sandbox)
}

# Non-sandbox cache entries (bare lines).
_bq_archive_main_lines() {
  local line
  while IFS= read -r line; do
    [[ -n $line ]] && printf '%s\n' "$line"
  done < <(_rlm-bq-cache read --main)
}

local fzf_out
fzf_out=$(
  {
    print -- "$refresh_sentinel"
    [[ -n $SANDBOX_BQ_PROJECT ]] && print -- "$refresh_sandbox_sentinel"
    _bq_archive_history_lines
    _bq_archive_sandbox_lines
    _bq_archive_main_lines
  } \
  | awk '{ key = $0; gsub(/\033\[[0-9;]*m/, "", key); if (key != "" && !seen[key]++) print }' \
  | fzf \
      --prompt="Select tables to ARCHIVE (TAB=multi)> " \
      --height=80% \
      --reverse \
      --no-mouse \
      --ansi \
      --multi \
      --preview='raw=$(printf "%s" {} | sed "s/\x1b\[[0-9;]*m//g"); case "$raw" in ---*) echo "Select to refresh the cache and reopen the picker." ;; *) "$HOME/bin/bq-preview" "$raw" ;; esac' \
      --preview-window=bottom:40%:wrap \
      --bind='ctrl-p:change-preview-window(bottom:70%:wrap|bottom:40%:wrap|hidden)' \
      --bind='ctrl-g:abort'
) || return 130

if [[ -z $fzf_out ]]; then
  print -u2 "bq-archive: no selection made"
  return 130
fi

local -a to_process to_process_colored to_process_is_sandbox
local sel_line sel_ref sel_proj sel_ds sel_tbl
local refresh_main_picked=0 refresh_sandbox_picked=0
while IFS= read -r sel_line; do
  [[ -z $sel_line ]] && continue
  sel_ref=$(printf '%s' "$sel_line" | sed 's/\x1b\[[0-9;]*m//g')
  [[ -z $sel_ref ]] && continue
  if _rlm-bq-refresh-sentinels is-main "$sel_ref"; then
    refresh_main_picked=1
    continue
  fi
  if _rlm-bq-refresh-sentinels is-sandbox "$sel_ref"; then
    refresh_sandbox_picked=1
    continue
  fi
  sel_proj=${sel_ref%%:*}
  sel_ds=${${sel_ref##*:}%%.*}
  sel_tbl=${sel_ref##*.}
  to_process+=("$sel_ref")
  to_process_colored+=("$(print -P "%F{cyan}${sel_proj}%f:%F{yellow}${sel_ds}%f.%F{green}${sel_tbl}%f")")
  # Sandbox classification: the raw fzf line is longer than its ANSI-stripped
  # form iff a color sequence was present (only sandbox entries have one).
  if [[ ${#sel_line} -gt ${#sel_ref} ]]; then
    to_process_is_sandbox+=(1)
  else
    to_process_is_sandbox+=(0)
  fi
done <<< "$fzf_out"

# A REFRESH pick short-circuits the rest of the run — re-invoke after
# refreshing the relevant cache(s). Picking REFRESH alongside real refs
# still wins (mirrors rlm-bq-rm-tables); the user can re-select the
# refreshed entries on the next pass.
if (( refresh_main_picked )); then
  _rlm-bq-refresh-sentinels apply-main || return 1
  rlm-bq-archive
  return $?
fi
if (( refresh_sandbox_picked )); then
  _rlm-bq-refresh-sentinels apply-sandbox || return 1
  rlm-bq-archive
  return $?
fi

if (( ${#to_process} == 0 )); then
  print -u2 "bq-archive: could not parse selection"
  return 1
fi

# ---------------------------------------------------------------------------
# View detection. `bq cp` on a view returns a confusing error several
# steps later in the flow ("BigQuery error in cp operation: Not found:
# Table … is a view"). Catch it upfront so we can give the user a clear
# "views don't need archiving" message and drop those entries before
# spending money on the three diagnostic queries per ref.
#
# Fan out `bq show` in parallel — one fork per selected ref — into a
# tmpdir; main process re-reads the type files in order. Output lines
# are limited to TABLE / VIEW / MATERIALIZED_VIEW / EXTERNAL / SNAPSHOT
# (anything else is treated as a hard error and bails the function).
# ---------------------------------------------------------------------------

local _type_dir
_type_dir=$(mktemp -d -t bq-archive-types.XXXXXX) || {
  print -u2 "bq-archive: failed to create tmpdir for type lookups"
  return 1
}

# _ref is already declared above (in_scope build). Re-declaring it bare
# would print "_ref=''" to stdout — `local` with no `=` is typeset in
# reporting mode. See the gotcha in zsh/AGENTS.md.
local _i _pid
local -a _type_pids
for (( _i = 1; _i <= ${#to_process}; _i++ )); do
  _ref="${to_process[$_i]}"
  # bq's project:dataset.table form is unambiguous; the dotted form is
  # not (bq treats project.dataset.table as dataset.table under the
  # default project). Keep the colon form.
  #
  # bq writes errors to *stdout* under --format=json (e.g. "BigQuery
  # error in show operation: Not found: Dataset ..."), so we capture
  # stdout to a separate .raw file and only feed jq a stream that
  # actually starts with '{'. The .raw file lets us detect "Not found"
  # errors below and mark the ref dead for the shared GC sweep.
  (
    bq --quiet show --format=json "$_ref" \
      >"${_type_dir}/${_i}.raw" 2>"${_type_dir}/${_i}.err"
    if [[ -s "${_type_dir}/${_i}.raw" ]] && head -c 1 "${_type_dir}/${_i}.raw" | grep -q '{'; then
      jq -r '.type // "UNKNOWN"' <"${_type_dir}/${_i}.raw" \
        2>>"${_type_dir}/${_i}.err" \
        >"${_type_dir}/${_i}.type"
    else
      : >"${_type_dir}/${_i}.type"
    fi
  ) &
  _type_pids+=($!)
done

for _pid in "${_type_pids[@]}"; do
  wait "$_pid" 2>/dev/null
done

local -a tables_to_process tables_to_process_colored tables_to_process_is_sandbox tables_to_process_type
local -a views_skipped views_skipped_colored views_skipped_types
local -a type_unknown dead_refs
local _type _raw_first _err_blob
for (( _i = 1; _i <= ${#to_process}; _i++ )); do
  _type=$(<"${_type_dir}/${_i}.type")
  case "$_type" in
    VIEW|MATERIALIZED_VIEW)
      views_skipped+=("${to_process[$_i]}")
      views_skipped_colored+=("${to_process_colored[$_i]}")
      views_skipped_types+=("$_type")
      ;;
    TABLE|EXTERNAL|SNAPSHOT)
      tables_to_process+=("${to_process[$_i]}")
      tables_to_process_colored+=("${to_process_colored[$_i]}")
      tables_to_process_is_sandbox+=("${to_process_is_sandbox[$_i]}")
      tables_to_process_type+=("$_type")
      ;;
    *)
      # Unknown type: most often this is a stale ref that the picker
      # cache still lists but BigQuery no longer has (dataset deleted,
      # table renamed, etc). `bq show` writes its error to *stdout*
      # under --format=json, so we sniff both .raw (stdout) and .err
      # (stderr) for "Not found" and write the ref to the shared
      # dead-refs file. _rlm-bq-dead-refs-gc, which runs at the top of
      # every rlm-bq-* invocation, will then prune the ref from every
      # cache file and from the pooled history on the user's next
      # picker launch.
      _raw_first=""
      [[ -s "${_type_dir}/${_i}.raw" ]] && _raw_first=$(head -c 200 "${_type_dir}/${_i}.raw" 2>/dev/null)
      _err_blob=""
      [[ -s "${_type_dir}/${_i}.err" ]] && _err_blob=$(<"${_type_dir}/${_i}.err")
      print -u2 "bq-archive: could not determine type for ${to_process[$_i]} (got '${_type:-empty}')"
      if [[ $_raw_first == *"Not found"* || $_err_blob == *"Not found"* ]]; then
        # Ref doesn't exist — mark dead so it gets GC'd on the next picker run.
        local _dead_file="$HOME/.cache/bq-open/dead-refs.txt"
        mkdir -p "${_dead_file:h}"
        print -r -- "${to_process[$_i]}" >>"$_dead_file"
        dead_refs+=("${to_process[$_i]}")
        print -u2 "  → ref does not exist; queued for pruning on next rlm-bq-* run"
      else
        if [[ -n $_raw_first ]]; then
          print -u2 -r -- "  bq show stdout: ${_raw_first}"
        fi
        if [[ -n $_err_blob ]]; then
          print -u2 -r -- "  bq show stderr: ${_err_blob}"
        fi
      fi
      type_unknown+=("${to_process[$_i]}")
      ;;
  esac
done
rm -rf "$_type_dir"

if (( ${#dead_refs} > 0 )); then
  print -u2 ""
  print -u2 "bq-archive: ${#dead_refs} ref(s) marked dead — re-run bq-archive and the picker will offer a clean list."
fi

# Views are not archivable — a view stores no data, it is a saved
# SELECT, so `bq cp` would copy nothing and the copy would lose the
# link to the source tables. But "not archivable" is not "nothing to
# do": the reason you selected it is that you want it gone. So views
# bypass the copy/verify machinery entirely and are carried straight
# to the delete stage at the end, where each is offered for deletion
# with its SQL definition shown inline.
if (( ${#views_skipped} > 0 )); then
  print ""
  print -P "%F{yellow}=== ${#views_skipped} view(s) selected — these cannot be archived ===%f"
  print "  A view stores no data of its own; it is just a saved SELECT, so"
  print "  there is nothing to copy into the archive dataset."
  print "  They will be offered for DELETION at the end of this run, with"
  print "  their SQL definitions shown so you can save them first."
  print ""
  local _v_i
  for (( _v_i = 1; _v_i <= ${#views_skipped}; _v_i++ )); do
    print -P "  - ${views_skipped_colored[$_v_i]}  %F{8}[${views_skipped_types[$_v_i]}]%f"
  done
fi

# Only bail early when there is nothing to do at all. A views-only
# selection still has work — the delete stage — so it must fall
# through rather than return here.
if (( ${#tables_to_process} == 0 && ${#views_skipped} == 0 )); then
  print ""
  print "bq-archive: nothing archivable or deletable in selection"
  return 0
fi

# Collapse to_process to the table-only subset so every downstream step
# (history append, diagnostics, copy, verification, drop instructions)
# operates on archivable refs only. Carry the per-ref TYPE forward so
# the copy block can label "Origin TABLE:" / "Origin EXTERNAL:" / etc.
to_process=("${tables_to_process[@]}")
to_process_colored=("${tables_to_process_colored[@]}")
to_process_is_sandbox=("${tables_to_process_is_sandbox[@]}")
local -a to_process_type
to_process_type=("${tables_to_process_type[@]}")

# Persist selections to the shared pooled history TSV. The "sandbox" flag
# is recorded whenever the pick came from a sandbox-coloured row, so every
# other rlm-bq-* picker can render it in purple too.
local hi
for (( hi = 1; hi <= ${#to_process}; hi++ )); do
  if (( to_process_is_sandbox[hi] )); then
    _rlm-bq-history append bq-archive "${to_process[$hi]}" sandbox
  else
    _rlm-bq-history append bq-archive "${to_process[$hi]}"
  fi
done

# ---------------------------------------------------------------------------
# Diagnostics + copy + verify — the table pipeline.
#
# `archive_stage_ok` tracks whether the pipeline is still viable. A
# views-only selection starts it at 0 and every table-only stage below
# is skipped, so the run falls through to the delete stage at the end
# rather than early-returning and stranding the views the user asked
# to remove. The same flag absorbs the pipeline's own abort conditions
# (every destination already exists, copy declined at the prompt,
# nothing copied) for the same reason: those end the *archiving*, not
# the run, whenever views are still pending.
#
# archive_rc carries the exit status those aborts used to return
# directly, so the function's final status still reports them.
# ---------------------------------------------------------------------------

local archive_stage_ok=1 archive_rc=0
(( ${#to_process} == 0 )) && archive_stage_ok=0

# ---------------------------------------------------------------------------
# Diagnostics: three queries per selected table
# ---------------------------------------------------------------------------

# Returns the GCP project that the diagnostics + INFORMATION_SCHEMA queries
# should run against. Defaults to the source project of the ref.
_bq_archive_query_project() {
  local src_proj="$1"
  print -r -- "${BQ_ARCHIVE_QUERY_PROJECT:-$src_proj}"
}

# Runs `bq query` and writes the JSON result to stdout. `--quiet` suppresses
# the "Waiting on bqjob_… Current status: RUNNING/DONE" status spinner that
# bq otherwise writes to stderr; without it, callers that capture `2>&1`
# end up with status text prepended to the JSON, breaking JSON parsing.
# Genuine errors (auth, syntax, missing dataset) still go to stderr.
# Args: <query_project> <sql> [extra bq args...]
_bq_archive_run_query() {
  local qp="$1" sql="$2"
  shift 2
  bq --quiet query \
    --use_legacy_sql=false \
    --format=prettyjson \
    --max_rows=200 \
    --project_id="$qp" \
    "$@" \
    "$sql"
}

# jq prelude shared by Query C's display and the pre-copy summary table.
# prettyjson returns INT64 columns as JSON strings, so every numeric
# field is coerced with tonumber before formatting.
local JQ_HUMANIZE='
  def hbytes(n):
    if n == null then "?"
    elif n < 1024            then (n|tostring) + " B"
    elif n < 1048576         then ((n/1024)         | . * 10 | floor / 10 | tostring) + " KiB"
    elif n < 1073741824      then ((n/1048576)      | . * 10 | floor / 10 | tostring) + " MiB"
    elif n < 1099511627776   then ((n/1073741824)   | . * 10 | floor / 10 | tostring) + " GiB"
    else                          ((n/1099511627776)| . * 10 | floor / 10 | tostring) + " TiB"
    end;
  def hrows(n):
    if n == null then "?"
    elif n < 1000        then (n|tostring)
    elif n < 1000000     then ((n/1000)        | . * 10 | floor / 10 | tostring) + "K"
    elif n < 1000000000  then ((n/1000000)     | . * 10 | floor / 10 | tostring) + "M"
    else                      ((n/1000000000)  | . * 10 | floor / 10 | tostring) + "B"
    end;
  def num(f): (f // null) | if . == null then null else tonumber end;
'

# Per-table facts harvested from Query C, indexed in lockstep with
# to_process. Populated below; consumed by the confirmation summary and
# by the post-copy verification gate (which compares the recorded source
# row count against the destination's). Missing values stay "?" so a
# table whose Query C failed still renders a row rather than vanishing
# from the confirmation list.
local -a summary_rows summary_bytes summary_modified summary_created
local i_init
for (( i_init = 1; i_init <= ${#to_process}; i_init++ )); do
  summary_rows+=("?")
  summary_bytes+=("?")
  summary_modified+=("?")
  summary_created+=("?")
done

local idx=0 ref_i src_proj src_ds src_tbl qp sql out row_count
local -a ignored_quoted
local _p
for _p in "${ignored_principals[@]}"; do
  ignored_quoted+=("\"$_p\"")
done
local ignored_sql_array="[${(j:,:)ignored_quoted}]"

for ref_i in "${to_process[@]}"; do
  idx=$(( idx + 1 ))
  src_proj=${ref_i%%:*}
  src_ds=${${ref_i##*:}%%.*}
  src_tbl=${ref_i##*.}
  qp=$(_bq_archive_query_project "$src_proj")

  print ""
  print -P "%F{magenta}=== [${idx}/${#to_process}] diagnostics for ${to_process_colored[$idx]} (queries in ${qp}) ===%f"

  # Query A: INFORMATION_SCHEMA.JOBS (last N days)
  # Filters on `referenced_tables` rather than text-grepping the query
  # body so view-mediated reads are caught: `referenced_tables` is
  # populated by BigQuery *after* view / UDF expansion. Match is an
  # exact (project, dataset, table) triple, so same-named tables in a
  # different dataset don't pollute the result.
  #
  # Output is pivoted by day: one row per `(day, query_clean)` with
  # that day's `runs` and `distinct_users` count, ordered by day
  # newest-first then runs descending. jq groups by day for display,
  # so the user sees a calendar-like view ("on 05-20 these distinct
  # queries hit the table N times each"), which makes spotting
  # cadence shifts (a dbt model that ran daily until last week, an
  # ad-hoc burst yesterday, etc.) trivial.
  #
  # Dedup key `query_clean` strips dbt's per-invocation
  # `"<uuid>" AS sdp_invocation_id` literal (without which every dbt
  # run looks unique) and `/* ... */` comments.
  #
  # NOTE: stays a single SELECT (CTE is one statement, no DECLARE / no
  # script). bq query --format=prettyjson wraps any script result in
  # an extra array layer ('[[{row}, ...]]' instead of '[{row}, ...]')
  # which breaks the `.[] | .field` jq filter below. src_proj / src_ds /
  # src_tbl come from the parsed bq ref so they're [A-Za-z0-9_-]+
  # identifiers — safe to inline.
  print -P "%F{blue}-- Query A: distinct queries per day that reference ${src_proj}:${src_ds}.${src_tbl} (after view expansion) in the last ${lookback_days} days --%f"
  print -P "%F{8}   (scope: jobs billed to ${qp}; set BQ_ARCHIVE_QUERY_PROJECT to inspect a different billing project)%f"
  sql="WITH hits AS (
  SELECT
    REGEXP_REPLACE(
      REGEXP_REPLACE(query, r'\"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\"', '\"<uuid>\"'),
      r'/\*[^*]*\*+(?:[^/*][^*]*\*+)*/', ''
    ) AS query_clean,
    creation_time,
    DATE(creation_time) AS day,
    user_email,
    statement_type
  FROM \`${qp}\`.\`region-eu\`.\`INFORMATION_SCHEMA\`.\`JOBS\`
  WHERE DATE(creation_time) > DATE_SUB(CURRENT_DATE(), INTERVAL ${lookback_days} DAY)
    AND job_type = 'QUERY'
    AND EXISTS (
      SELECT 1
      FROM UNNEST(referenced_tables) AS rt
      WHERE rt.project_id = '${src_proj}'
        AND rt.dataset_id = '${src_ds}'
        AND rt.table_id   = '${src_tbl}'
    )
)
SELECT
  CAST(day AS STRING) AS day,
  ANY_VALUE(statement_type) AS statement_type,
  COUNT(*) AS runs,
  COUNT(DISTINCT user_email) AS distinct_users,
  SUBSTR(REGEXP_REPLACE(TRIM(query_clean), r'\s+', ' '), 1, 280) AS query_excerpt
FROM hits
GROUP BY day, query_clean
ORDER BY day DESC, runs DESC, statement_type
LIMIT 200;"
  out=$(_bq_archive_run_query "$qp" "$sql")
  if (( $? != 0 )); then
    print -u2 "bq-archive: Query A failed (see error above)"
  elif [[ $out == \[* ]]; then
    row_count=$(print -r -- "$out" | jq 'length')
    print "(day, query) rows: $row_count"
    if (( row_count > 0 )); then
      # group_by emits sorted-ascending groups, so we sort_by(.[0].day)
      # | reverse to put newest-first while preserving the SQL ORDER
      # within each group (runs DESC, statement_type). Each group emits
      # one header line (the day) and one paragraph per distinct query
      # under it (`<statement_type> runs=<N> users=<M>` + indented
      # excerpt on the next line).
      print -r -- "$out" | jq -r '
        group_by(.day) | sort_by(.[0].day) | reverse | .[] |
        .[0].day,
        (.[] |
          "  " + (.statement_type // "?") +
          " runs=" + ((.runs // "0") | tostring) +
          " users=" + ((.distinct_users // "0") | tostring) +
          "\n    " + (.query_excerpt // "")
        )
      '
    fi
  else
    print -u2 "bq-archive: Query A returned unexpected output:"
    print -u2 -r -- "$out"
  fi

  # Query B: audit log (last N days, principals filtered)
  # Match the exact (dataset, table) path at the end of resourceName,
  # not a wildcard `%${src_tbl}%` on the whole path. The previous form
  # was dominated by false positives — anywhere the table name appears
  # as a substring of the resource path (e.g. dataset names that
  # contain "events" like `sdp_psa_adjust_events`, or temp-result
  # tables scoped under such datasets) would match. Anchoring on
  # `/datasets/<src_ds>/tables/<src_tbl>` cuts the result down to
  # genuine reads/writes of the table itself.
  #
  # Defense-in-depth: even with an anchored path, drop three classes
  # of BigQuery-managed shadow tables that may share the same
  # `tables/<name>` suffix when name collisions happen:
  #   /datasets/_<hex>/...   — anonymous query-result cache (24h TTL)
  #   /tables/anon<hex>      — script/session temp tables
  #   /tables/..._dbt_tmp    — dbt incremental staging tables
  # These don't represent user-visible reads of the source table —
  # they're BigQuery's internal materialization plumbing.
  #
  # See "single SELECT only" note on Query A — same constraint applies.
  # Inline the pattern + ignored-principals array as SQL literals.
  print ""
  print -P "%F{blue}-- Query B: data-access audit log for ${src_ds}.${src_tbl} (excluding ${#ignored_principals} ignored principals; cache/tmp tables filtered) --%f"
  sql="SELECT
  DATE(timestamp) AS date,
  protopayload_auditlog.authenticationInfo.principalEmail AS principal,
  protopayload_auditlog.resourceName                       AS resource,
  COUNT(*)                                                 AS hits
FROM \`${qp}.bq_log.cloudaudit_googleapis_com_data_access\`
WHERE DATE(timestamp) > DATE_SUB(CURRENT_DATE(), INTERVAL ${lookback_days} DAY)
  AND protopayload_auditlog.resourceName LIKE '%/datasets/${src_ds}/tables/${src_tbl}'
  AND protopayload_auditlog.authenticationInfo.principalEmail NOT IN UNNEST(${ignored_sql_array})
  AND NOT REGEXP_CONTAINS(protopayload_auditlog.resourceName, r'/datasets/_[0-9a-f]+/tables/')
  AND NOT REGEXP_CONTAINS(protopayload_auditlog.resourceName, r'/tables/anon[0-9a-f]+$')
  AND NOT REGEXP_CONTAINS(protopayload_auditlog.resourceName, r'__dbt_tmp$')
GROUP BY 1, 2, 3
ORDER BY 1 DESC, 4 DESC
LIMIT 100;"
  out=$(_bq_archive_run_query "$qp" "$sql")
  if (( $? != 0 )); then
    print -u2 "bq-archive: Query B failed (table may not exist or you lack access; see error above)"
  elif [[ $out == \[* ]]; then
    row_count=$(print -r -- "$out" | jq 'length')
    print "rows: $row_count"
    if (( row_count > 0 )); then
      print -r -- "$out" | jq -r '.[] | "  " + (.date // "?") + "  " + ((.hits|tostring) // "0") + "  " + (.principal // "?") + "  " + (.resource // "?")'
    fi
  else
    print -u2 "bq-archive: Query B returned unexpected output:"
    print -u2 -r -- "$out"
  fi

  # Query C: TABLES + TABLE_STORAGE (freshness)
  # Returns exactly one row for the exact (project, dataset, table)
  # the picker selected. Previously matched WHERE t.table_name LIKE
  # '%${src_tbl}%', which collapsed the project's whole namespace of
  # similarly-named tables (e.g. for `events` it pulled rows for
  # `events_archive`, `dim_events`, `fct_events_daily`, …) and
  # capped with LIMIT 20 to hide the mess. Anchoring on
  # `t.table_schema = '${src_ds}' AND t.table_name = '${src_tbl}'`
  # makes the result single-row and exact.
  #
  # LEFT JOIN against TABLE_STORAGE because views, external tables,
  # and snapshots are in TABLES but not in TABLE_STORAGE — keep the
  # row visible (with NULL storage cols) for those cases.
  #
  # See "single SELECT only" note on Query A — same constraint applies.
  print ""
  print -P "%F{blue}-- Query C: storage freshness for ${src_ds}.${src_tbl} --%f"
  sql="SELECT
  t.table_type,
  t.creation_time,
  ts.storage_last_modified_time,
  ts.total_logical_bytes,
  ts.total_rows
FROM \`${qp}\`.\`region-eu\`.\`INFORMATION_SCHEMA\`.\`TABLES\` t
LEFT JOIN \`${qp}\`.\`region-eu\`.\`INFORMATION_SCHEMA\`.\`TABLE_STORAGE\` ts
  USING(table_catalog, table_schema, table_name)
WHERE t.table_schema = '${src_ds}'
  AND t.table_name   = '${src_tbl}';"
  out=$(_bq_archive_run_query "$qp" "$sql")
  if (( $? != 0 )); then
    print -u2 "bq-archive: Query C failed (see error above)"
  elif [[ $out == \[* ]]; then
    row_count=$(print -r -- "$out" | jq 'length')
    if (( row_count == 0 )); then
      print -u2 "bq-archive: Query C — no row in INFORMATION_SCHEMA.TABLES for ${src_ds}.${src_tbl} (table may have been deleted already)"
    else
      # Labeled-block render. `rows` and `logical_bytes` are
      # humanized in jq (K/M/B for rows, KiB/MiB/GiB/TiB for bytes)
      # since the raw numbers are unreadable at a glance. Strings
      # are quoted from prettyjson so .total_logical_bytes etc.
      # come in as STRING — coerce via tonumber.
      print -r -- "$out" | jq -r "$JQ_HUMANIZE"'
        .[] |
        "  type:           " + (.table_type // "?"),
        "  created:        " + (.creation_time // "?"),
        "  last_modified:  " + (.storage_last_modified_time // "(no TABLE_STORAGE row — view/external/snapshot)"),
        "  rows:           " + hrows(num(.total_rows)) + ((.total_rows // null) | if . == null then "" else "  (" + . + ")" end),
        "  logical_bytes:  " + hbytes(num(.total_logical_bytes)) + ((.total_logical_bytes // null) | if . == null then "" else "  (" + . + ")" end)
      '

      # Harvest the same row into the summary arrays so the
      # confirmation block can show size / rows / freshness without
      # re-querying, and so the post-copy gate has a source row count
      # to compare the destination against. Fields are emitted on one
      # tab-separated line and split positionally — `storage_last_modified_time`
      # is NULL for external/snapshot sources, and `IFS=$'\t' read`
      # would collapse that empty field and shift every later value
      # left (see zsh/AGENTS.md).
      # Both locals carry an explicit initializer: this is a loop body,
      # and a bare `local x` re-declaration prints "x=<value>" to stdout
      # on every iteration after the first (see zsh/AGENTS.md).
      local _c_line=''
      _c_line=$(print -r -- "$out" | jq -r '
        .[0] |
        [ (.total_rows // ""), (.total_logical_bytes // ""),
          (.storage_last_modified_time // ""), (.creation_time // "") ]
        | @tsv
      ' 2>/dev/null)
      if [[ -n $_c_line ]]; then
        local -a _c_f=()
        _c_f=("${(@s:	:)_c_line}")
        [[ -n ${_c_f[1]:-} ]] && summary_rows[$idx]=${_c_f[1]}
        [[ -n ${_c_f[2]:-} ]] && summary_bytes[$idx]=${_c_f[2]}
        [[ -n ${_c_f[3]:-} ]] && summary_modified[$idx]=${_c_f[3]}
        [[ -n ${_c_f[4]:-} ]] && summary_created[$idx]=${_c_f[4]}
      fi
    fi
  else
    print -u2 "bq-archive: Query C returned unexpected output:"
    print -u2 -r -- "$out"
  fi
done

# ---------------------------------------------------------------------------
# Confirmation
# ---------------------------------------------------------------------------

local archive_target_default archive_target archive_proj archive_ds
archive_target_default="${${to_process[1]%%:*}}.archival_data"
archive_target="${BQ_ARCHIVE_TARGET:-$archive_target_default}"
archive_proj=${archive_target%%.*}
archive_ds=${archive_target##*.}

# Humanize a raw byte / row count captured from Query C. Delegates to
# the same jq definitions used above so the confirmation table and the
# per-table diagnostics never disagree on a size. "?" passes through.
_bq_archive_human() {
  local kind="$1" raw="$2"
  [[ -z $raw || $raw == "?" ]] && { print -r -- "?"; return 0; }
  jq -rn "$JQ_HUMANIZE"' $v | tonumber as $n | if $k == "bytes" then hbytes($n) else hrows($n) end' \
    --arg v "$raw" --arg k "$kind" 2>/dev/null || print -r -- "$raw"
}

# Trim BigQuery's fractional seconds + " UTC" suffix so the timestamp
# fits the column: "2026-05-20 11:04:31.921000 UTC" -> "2026-05-20 11:04".
_bq_archive_short_ts() {
  local ts="$1"
  [[ -z $ts || $ts == "?" ]] && { print -r -- "?"; return 0; }
  print -r -- "${ts[1,16]}"
}

# Middle-elide an over-long bq ref so the TABLE column keeps its width
# and the row stays under 80 display columns. A ref that overflows the
# column would push every later column right and destroy the alignment
# that makes this table scannable — and a wrapped row is worse than an
# elided one, since the numbers are the point here. Head and tail are
# both kept: the tail holds the table name, the head the project.
_bq_archive_elide() {
  local s="$1" max="$2"
  (( ${#s} <= max )) && { print -r -- "$s"; return 0; }
  local keep=$(( max - 1 ))
  local head_n=$(( keep / 2 )) tail_n=$(( keep - keep / 2 ))
  print -r -- "${s[1,head_n]}…${s[-tail_n,-1]}"
}

if (( archive_stage_ok )); then

print ""
print -P "%F{yellow}=== About to archive ${#to_process} table(s) ===%f"
print ""
# Widths are sized so the longest possible row is 78 display columns:
# 2 indent + 42 ref + 1 + 7 rows + 1 + 8 size + 1 + 16 timestamp. A
# wrapped row would defeat the point of tabulating these at all.
printf '  %-42s %-7s %-8s %s\n' "TABLE" "ROWS" "SIZE" "DATA UPDATED"
printf '  %-42s %-7s %-8s %s\n' \
  "------------------------------------------" \
  "-------" "--------" "----------------"
local i _h_rows _h_bytes _h_mod _h_ref
for (( i = 1; i <= ${#to_process}; i++ )); do
  _h_rows=$(_bq_archive_human rows "${summary_rows[$i]}")
  _h_bytes=$(_bq_archive_human bytes "${summary_bytes[$i]}")
  _h_mod=$(_bq_archive_short_ts "${summary_modified[$i]}")
  _h_ref=$(_bq_archive_elide "${to_process[$i]}" 42)
  # Print the uncolored ref: printf pads by byte count, so the ANSI
  # sequences in to_process_colored would be counted as width and
  # misalign every later column. Full refs are listed unelided below.
  printf '  %-42s %-7s %-8s %s\n' \
    "$_h_ref" "$_h_rows" "$_h_bytes" "$_h_mod"
done

# The table may have elided a ref, and a delete decision should never
# rest on a truncated name — list the full refs underneath, colored.
local _any_elided=0
for (( i = 1; i <= ${#to_process}; i++ )); do
  (( ${#to_process[$i]} > 42 )) && _any_elided=1
done
if (( _any_elided )); then
  print ""
  print "  Full references:"
  for (( i = 1; i <= ${#to_process}; i++ )); do
    print "    - ${to_process_colored[$i]}"
  done
fi

print ""
print "  ROWS / SIZE / DATA UPDATED come from INFORMATION_SCHEMA.TABLE_STORAGE"
print "  (storage_last_modified_time — actual data writes, not metadata edits)."
print "  '?' means Query C returned no storage row for that table."

print ""
print "Archive target dataset: ${archive_proj}.${archive_ds}"
print "Each source table is copied to ${archive_proj}:${archive_ds}.<table_name>"
print "with 'bq cp --no_clobber', which fails rather than overwrite an existing"
print "destination table."

# ---------------------------------------------------------------------------
# Destination pre-flight. `bq cp --no_clobber` already refuses to
# overwrite, but it only says so per-table midway through the copy loop
# — after the user has typed 'yes'. Probing up front turns "3 of 5
# copies mysteriously failed" into a list shown before the prompt, so
# the decision is made with the collisions visible.
#
# Fan out `bq show` one fork per destination. Exit status alone
# classifies: 0 = exists, non-zero = absent (or unreadable, which
# surfaces as a copy failure later anyway).
# ---------------------------------------------------------------------------

local _dst_dir
_dst_dir=$(mktemp -d -t bq-archive-dst.XXXXXX) || {
  print -u2 "bq-archive: failed to create tmpdir for destination probes"
  return 1
}

local -a _dst_pids
local _di _dst_probe
for (( _di = 1; _di <= ${#to_process}; _di++ )); do
  _dst_probe="${archive_proj}:${archive_ds}.${to_process[$_di]##*.}"
  (
    if bq --quiet show --format=json "$_dst_probe" >/dev/null 2>&1; then
      print -n 1 >"${_dst_dir}/${_di}.exists"
    else
      : >"${_dst_dir}/${_di}.exists"
    fi
  ) &
  _dst_pids+=($!)
done
for _pid in "${_dst_pids[@]}"; do
  wait "$_pid" 2>/dev/null
done

local -a dst_exists
for (( _di = 1; _di <= ${#to_process}; _di++ )); do
  if [[ -s "${_dst_dir}/${_di}.exists" ]]; then
    dst_exists+=(1)
  else
    dst_exists+=(0)
  fi
done
rm -rf "$_dst_dir"

local _n_collisions=0
for (( _di = 1; _di <= ${#dst_exists}; _di++ )); do
  (( dst_exists[_di] )) && _n_collisions=$(( _n_collisions + 1 ))
done

if (( _n_collisions > 0 )); then
  print ""
  print -P "%F{red}=== ${_n_collisions} destination table(s) ALREADY EXIST ===%f"
  print "  These will be skipped — bq cp --no_clobber will not overwrite them,"
  print "  and their source tables will NOT be offered for deletion:"
  for (( _di = 1; _di <= ${#to_process}; _di++ )); do
    (( dst_exists[_di] )) || continue
    print -P "    - %F{red}${archive_proj}:${archive_ds}.${to_process[$_di]##*.}%f"
  done
fi

if (( _n_collisions == ${#to_process} )); then
  print ""
  print -u2 "bq-archive: every destination already exists; nothing to copy"
  archive_stage_ok=0
  archive_rc=1
fi

if (( archive_stage_ok )); then
  print ""
  local confirm
  vared -p "Proceed with archive copy? Type 'yes' to continue: " confirm
  if [[ $confirm != "yes" ]]; then
    print "bq-archive: archive copy cancelled"
    archive_stage_ok=0
    archive_rc=1
  fi
fi

fi  # end: confirmation stage (archive_stage_ok)

# ---------------------------------------------------------------------------
# Copy step: bq cp --no_clobber per table.
#
# For every copy we print, in order:
#   1. the exact `bq cp --no_clobber <src> <dst>` command (so the user
#      can re-run it manually or paste it into a runbook)
#   2. Origin <TYPE>: <fqn>  + GCP console URL
#   3. Destination TABLE: <fqn>  + GCP console URL
# The destination type is always TABLE because `bq cp` of any source
# materializes a managed table; the origin TYPE is whatever the
# upfront `bq show` classified it as (TABLE / EXTERNAL / SNAPSHOT —
# VIEWs were filtered out earlier).
# ---------------------------------------------------------------------------

# copied_idx tracks each successful copy's index into to_process, so the
# verification and delete stages can reach that table's Query C facts
# (summary_rows / summary_bytes) without re-deriving them from the ref.
local -a copied copied_idx failed skipped
local src dst src_type src_url dst_url ci
# Loop bound is 0 when the pipeline was skipped or aborted (views-only
# selection, all destinations present, copy declined), leaving copied
# empty so the verification and table-delete stages are no-ops too.
local _copy_n=0
(( archive_stage_ok )) && _copy_n=${#to_process}
for (( ci = 1; ci <= _copy_n; ci++ )); do
  src="${to_process[$ci]}"
  src_type="${to_process_type[$ci]}"
  # src is "src_proj:src_ds.src_tbl" — derive bare table name
  src_tbl=${src##*.}
  dst="${archive_proj}:${archive_ds}.${src_tbl}"

  if (( dst_exists[ci] )); then
    skipped+=("$src")
    print ""
    print -P "%F{magenta}=== [${ci}/${#to_process}] copy ===%f"
    print -u2 "bq-archive: SKIPPED ${src} — destination ${dst} already exists"
    continue
  fi

  src_url=$("$HOME/bin/bq-console-url" "$src" 2>/dev/null)
  dst_url=$("$HOME/bin/bq-console-url" "$dst" 2>/dev/null)

  print ""
  print -P "%F{magenta}=== [${ci}/${#to_process}] copy ===%f"
  print -P "%F{8}command:%f bq cp --no_clobber ${src} ${dst}"

  if bq cp --no_clobber "$src" "$dst" 2>&1; then
    copied+=("${src}|${dst}")
    copied_idx+=("$ci")
    print -u2 "bq-archive: copied  ${src} -> ${dst}"
    print -P "%F{cyan}Origin      ${src_type}:%f ${src}"
    [[ -n $src_url ]] && print -P "%F{8}            %f${src_url}"
    print -P "%F{green}Destination TABLE:%f ${dst}"
    [[ -n $dst_url ]] && print -P "%F{8}            %f${dst_url}"
  else
    failed+=("$src")
    print -u2 "bq-archive: FAILED  ${src} (bq cp --no_clobber refuses to overwrite an existing target)"
  fi
done

if (( _copy_n > 0 )); then
  print ""
  print "Summary: ${#copied} copied, ${#failed} failed, ${#skipped} skipped (destination existed)"
fi

# ---------------------------------------------------------------------------
# Verification: side-by-side preview for each successful copy
# ---------------------------------------------------------------------------

# verified[] is the gate for the delete stage: 1 only when the live
# COUNT(*) on both sides agree. Anything else — a count mismatch, a
# failed query, a byte-size discrepancy — leaves it 0 and the source
# table is never offered for deletion.
#
# Two independent checks per pair:
#   1. SELECT COUNT(*) on source and destination. This is the
#      authoritative one and the only one that gates: it reads the
#      actual rows rather than trusting metadata.
#   2. TABLE_STORAGE total_rows / total_logical_bytes. Advisory only.
#      TABLE_STORAGE lags writes by minutes, so a freshly-created
#      destination legitimately reports 0 rows / 0 bytes for a while;
#      gating on it would block every delete on a fast run. Reported so
#      a genuine size discrepancy is visible, but it never blocks.
local -a verified verify_note
if (( ${#copied} > 0 )); then
  print ""
  print -P "%F{magenta}=== Verification (source vs archive) ===%f"
  print "  COUNT(*) on both sides gates deletion. TABLE_STORAGE bytes are"
  print "  advisory — it lags writes by minutes, so a fresh copy may read 0."

  local pair s d vi v_src_cnt v_dst_cnt v_out v_qp
  local v_src_bytes v_dst_bytes v_src_h v_dst_h
  for (( vi = 1; vi <= ${#copied}; vi++ )); do
    pair="${copied[$vi]}"
    s=${pair%%|*}
    d=${pair##*|}
    verified+=(0)
    verify_note+=("")

    print ""
    print -P "%F{cyan}--- ${s}%f  ->  %F{green}${d}%f ---"

    v_qp=$(_bq_archive_query_project "${s%%:*}")

    # COUNT(*) both sides. SQL identifiers use dots, not colons.
    v_out=$(_bq_archive_run_query "$v_qp" \
      "SELECT COUNT(*) AS n FROM \`${s/:/.}\`;" 2>/dev/null)
    v_src_cnt=$(print -r -- "$v_out" | jq -r '.[0].n // empty' 2>/dev/null)

    v_out=$(_bq_archive_run_query "$v_qp" \
      "SELECT COUNT(*) AS n FROM \`${d/:/.}\`;" 2>/dev/null)
    v_dst_cnt=$(print -r -- "$v_out" | jq -r '.[0].n // empty' 2>/dev/null)

    if [[ -z $v_src_cnt || -z $v_dst_cnt ]]; then
      verify_note[$vi]="COUNT(*) query failed on one or both sides"
      print -P "  %F{red}✗ COUNT(*) could not be read (src='${v_src_cnt:-?}' dst='${v_dst_cnt:-?}')%f"
    elif [[ $v_src_cnt == "$v_dst_cnt" ]]; then
      verified[$vi]=1
      print -P "  %F{green}✓ COUNT(*) match:%f source=${v_src_cnt}  archive=${v_dst_cnt}"
    else
      verify_note[$vi]="COUNT(*) mismatch: source=${v_src_cnt} archive=${v_dst_cnt}"
      print -P "  %F{red}✗ COUNT(*) MISMATCH:%f source=${v_src_cnt}  archive=${v_dst_cnt}"
    fi

    # TABLE_STORAGE bytes, advisory. The archive dataset lives in
    # archive_proj, which is not necessarily the source project (and not
    # necessarily BQ_ARCHIVE_QUERY_PROJECT either), so the destination's
    # INFORMATION_SCHEMA must be addressed under archive_proj.
    v_out=$(_bq_archive_run_query "$archive_proj" \
      "SELECT total_rows, total_logical_bytes
       FROM \`${archive_proj}\`.\`region-eu\`.\`INFORMATION_SCHEMA\`.\`TABLE_STORAGE\`
       WHERE table_schema = '${archive_ds}' AND table_name = '${d##*.}';" 2>/dev/null)
    v_dst_bytes=$(print -r -- "$v_out" | jq -r '.[0].total_logical_bytes // empty' 2>/dev/null)
    v_src_bytes="${summary_bytes[${copied_idx[$vi]}]}"

    if [[ -n $v_dst_bytes && -n $v_src_bytes && $v_src_bytes != "?" ]]; then
      v_src_h=$(_bq_archive_human bytes "$v_src_bytes")
      v_dst_h=$(_bq_archive_human bytes "$v_dst_bytes")
      if [[ $v_src_bytes == "$v_dst_bytes" ]]; then
        print -P "  %F{green}✓ TABLE_STORAGE bytes match:%f ${v_src_h}"
      else
        print -P "  %F{yellow}• TABLE_STORAGE bytes differ:%f source=${v_src_h}  archive=${v_dst_h}  %F{8}(advisory — storage stats lag writes)%f"
      fi
    else
      print -P "  %F{8}• TABLE_STORAGE bytes unavailable for comparison%f"
    fi
  done
fi

# ---------------------------------------------------------------------------
# Drop instructions: print + write to a timestamped .sql file
# ---------------------------------------------------------------------------

# Nothing copied means there is no table-delete work and no DROP file
# to write. Return only if there are also no views pending — otherwise
# fall through to the delete stage, which is the whole point of a
# views-only selection.
if (( ${#copied} == 0 )); then
  if (( _copy_n > 0 )); then
    print ""
    print -u2 "bq-archive: nothing was copied; no DROP instructions emitted"
    archive_rc=1
  fi
  if (( ${#views_skipped} == 0 )); then
    return $archive_rc
  fi
fi

# ---------------------------------------------------------------------------
# Deletion of the source tables — one prompt per table, gated on
# verification. A source is only offered when its COUNT(*) matched the
# archive copy's; an unverified pair is reported and skipped, never
# prompted for, so a bad copy cannot be talked into a delete by
# reflexively typing 'yes'.
#
# Confirmation is the full table name rather than 'yes': at this point
# the prompts are near-identical and repeated N times, which is exactly
# the shape that trains you to type the magic word without reading. The
# name has to be looked at to be typed.
#
# Anything not deleted here (unverified, declined, or failed) still
# gets DROP instructions written to the .sql file below.
# ---------------------------------------------------------------------------

local -a deleted delete_failed not_deleted
local di d_src d_dst d_ans d_tbl d_rows d_bytes

if (( ${#copied} > 0 )); then
  print ""
  print -P "%F{yellow}=== Delete source tables ===%f"
  print "  Sources are deleted one at a time, only where verification passed."
  print "  Confirm by typing the table name exactly; anything else skips it."
fi

for (( di = 1; di <= ${#copied}; di++ )); do
  d_src=${copied[$di]%%|*}
  d_dst=${copied[$di]##*|}
  d_tbl=${d_src##*.}

  print ""
  print -P "%F{magenta}--- [${di}/${#copied}] ${d_src} ---%f"

  if (( ! verified[di] )); then
    not_deleted+=("$d_src")
    print -P "  %F{red}NOT OFFERED — verification failed:%f ${verify_note[$di]}"
    print "  Investigate the copy before deleting anything. DROP SQL is still"
    print "  written to the file below if you decide to proceed by hand."
    continue
  fi

  d_rows=$(_bq_archive_human rows "${summary_rows[${copied_idx[$di]}]}")
  d_bytes=$(_bq_archive_human bytes "${summary_bytes[${copied_idx[$di]}]}")

  print -P "  %F{green}verified%f — archive copy has the same COUNT(*)"
  print "  source:   ${d_src}   (${d_rows} rows, ${d_bytes})"
  print "  archive:  ${d_dst}"
  print -P "  %F{red}This permanently deletes the source table.%f"

  d_ans=""
  vared -p "  Type '${d_tbl}' to DELETE the source (anything else skips): " d_ans

  if [[ $d_ans != "$d_tbl" ]]; then
    not_deleted+=("$d_src")
    print "  skipped — ${d_src} left in place"
    continue
  fi

  if bq rm --force --table "$d_src" 2>&1; then
    deleted+=("$d_src")
    print -P "  %F{green}deleted%f ${d_src}"
    _rlm-bq-history append bq-archive "$d_src" archived deleted
  else
    delete_failed+=("$d_src")
    print -u2 "  bq-archive: FAILED to delete ${d_src}"
  fi
done

# ---------------------------------------------------------------------------
# Deletion of selected VIEWs.
#
# Views were never copied — there is nothing in a view to archive — so
# there is no verification gate here and nothing to compare against.
# The gate is instead the definition itself: a view's SQL is the only
# thing lost when it is dropped, so it is printed in full immediately
# above the prompt. Read it, copy it if you want it, then confirm.
#
# `bq show --view` works only for standard VIEWs; MATERIALIZED_VIEWs
# need --materialized_view or the definition is missing from the
# output. A materialized view does hold data, but that data is derived
# and is regenerated from the definition, so it is still the SQL — not
# the bytes — that is worth keeping.
# ---------------------------------------------------------------------------

local -a views_deleted views_kept views_delete_failed
if (( ${#views_skipped} > 0 )); then
  print ""
  print -P "%F{yellow}=== Delete ${#views_skipped} selected view(s) ===%f"
  print "  Views hold no data of their own, so there is nothing to archive —"
  print "  deleting is the only meaningful action. Each definition is shown"
  print "  below; save any you might need before confirming."
  print "  Confirm by typing the view name exactly; anything else skips it."

  local vd_i vd_ref vd_type vd_name vd_url vd_flag vd_ans vd_def
  for (( vd_i = 1; vd_i <= ${#views_skipped}; vd_i++ )); do
    vd_ref="${views_skipped[$vd_i]}"
    vd_type="${views_skipped_types[$vd_i]}"
    vd_name=${vd_ref##*.}

    print ""
    print -P "%F{magenta}--- [${vd_i}/${#views_skipped}] ${vd_ref}  [${vd_type}] ---%f"

    vd_url=$("$HOME/bin/bq-console-url" "$vd_ref" 2>/dev/null)
    [[ -n $vd_url ]] && print -P "  %F{8}${vd_url}%f"

    if [[ $vd_type == MATERIALIZED_VIEW ]]; then
      vd_flag="--materialized_view"
    else
      vd_flag="--view"
    fi

    # Pull the definition from the JSON payload rather than bq's table
    # rendering, which truncates long SQL to fit the terminal.
    vd_def=$(bq --quiet show --format=json "$vd_flag" "$vd_ref" 2>/dev/null \
      | jq -r '.view.query // .materializedView.query // empty' 2>/dev/null)

    if [[ -n $vd_def ]]; then
      print -P "  %F{8}--- SQL definition (save this if you may need it) ---%f"
      print -r -- "$vd_def" | sed 's/^/    /'
      print -P "  %F{8}--- end definition ---%f"
    else
      print -P "  %F{red}could not read the definition%f — recover it with:"
      print "    bq show ${vd_flag} ${vd_ref}"
      print "  Deleting without a saved definition is unrecoverable."
    fi

    print -P "  %F{red}This permanently deletes the view.%f"

    vd_ans=""
    vared -p "  Type '${vd_name}' to DELETE this view (anything else skips): " vd_ans

    if [[ $vd_ans != "$vd_name" ]]; then
      views_kept+=("$vd_ref")
      print "  skipped — ${vd_ref} left in place"
      continue
    fi

    if bq rm --force --table "$vd_ref" 2>&1; then
      views_deleted+=("$vd_ref")
      print -P "  %F{green}deleted%f ${vd_ref}"
      _rlm-bq-history append bq-archive "$vd_ref" view deleted
    else
      views_delete_failed+=("$vd_ref")
      print -u2 "  bq-archive: FAILED to delete ${vd_ref}"
    fi
  done
fi

if (( ${#copied} > 0 || ${#views_skipped} > 0 )); then
  print ""
  if (( ${#copied} > 0 )); then
    print "Delete summary (tables): ${#deleted} deleted, ${#not_deleted} kept, ${#delete_failed} failed"
  fi
  if (( ${#views_skipped} > 0 )); then
    print "Delete summary (views):  ${#views_deleted} deleted, ${#views_kept} kept, ${#views_delete_failed} failed"
  fi
fi

# Deleted views leave the pickers by the same route as deleted tables.
if (( ${#views_deleted} > 0 )); then
  local _vdead_file="$HOME/.cache/bq-open/dead-refs.txt"
  mkdir -p "${_vdead_file:h}"
  local _vd
  for _vd in "${views_deleted[@]}"; do
    print -r -- "$_vd" >>"$_vdead_file"
  done
fi

# Deleted sources must leave the pickers, or the next run offers refs
# that no longer exist. dead-refs.txt is the shared channel the GC at
# the top of every rlm-bq-* invocation drains.
if (( ${#deleted} > 0 )); then
  local _dead_file="$HOME/.cache/bq-open/dead-refs.txt"
  mkdir -p "${_dead_file:h}"
  local _d
  for _d in "${deleted[@]}"; do
    print -r -- "$_d" >>"$_dead_file"
  done
  print "Deleted refs queued for cache pruning on the next rlm-bq-* run."
fi

# DROP instructions cover only the sources still standing — the ones
# skipped at the prompt, blocked by verification, or whose `bq rm`
# failed. Emitting statements for already-deleted tables would leave a
# file whose statements error out on a second run and obscure the ones
# that still matter.
local -a pending_drop
pending_drop=("${not_deleted[@]}" "${delete_failed[@]}")

if (( ${#pending_drop} == 0 )); then
  if (( ${#copied} > 0 )); then
    print ""
    print -P "%F{green}All copied source tables were deleted; no DROP instructions needed.%f"
  fi
  (( ${#failed} > 0 || ${#skipped} > 0 )) && archive_rc=1
  (( ${#views_delete_failed} > 0 )) && archive_rc=1
  return $archive_rc
fi

local ts drop_file
ts=$(date +%Y%m%d-%H%M%S)
drop_file="${TMPDIR:-/tmp}/bq-archive-drop-${ts}.sql"

{
  print -- "-- bq-archive: generated $(date '+%Y-%m-%d %H:%M:%S')"
  print -- "-- Source tables successfully copied to ${archive_proj}.${archive_ds}"
  print -- "-- but NOT deleted (declined at the prompt, blocked by failed"
  print -- "-- verification, or the delete itself failed)."
  print -- "-- Review the diagnostics output above and your downstream consumers"
  print -- "-- BEFORE running any of the statements below."
  if (( ${#delete_failed} > 0 )); then
    print -- ""
    print -- "-- WARNING: these were confirmed for deletion but 'bq rm' failed:"
    for s in "${delete_failed[@]}"; do
      print -- "--   ${s}"
    done
  fi
  print -- ""
  print -- "-- ============================================================"
  print -- "-- Drop the original source tables (run in BigQuery UI / bq query):"
  print -- "-- ============================================================"
  for s in "${pending_drop[@]}"; do
    # SQL identifier uses dots, not colons
    print -- "DROP TABLE \`${s/:/.}\`;"
  done
  print -- ""
  print -- "-- ============================================================"
  print -- "-- Or via the bq CLI:"
  print -- "-- ============================================================"
  for s in "${pending_drop[@]}"; do
    print -- "-- bq rm --table ${s}"
  done
  print -- ""
  print -- "-- ============================================================"
  print -- "-- Find downstream views / procedures that reference each table:"
  print -- "-- ============================================================"
  for s in "${pending_drop[@]}"; do
    src_proj=${s%%:*}
    src_tbl=${s##*.}
    qp=$(_bq_archive_query_project "$src_proj")
    print -- "-- For ${s}:"
    print -- "SELECT table_catalog, table_schema, table_name, table_type"
    print -- "FROM \`${qp}\`.\`region-eu\`.\`INFORMATION_SCHEMA\`.\`VIEWS\`"
    print -- "WHERE LOWER(view_definition) LIKE LOWER('%${src_tbl}%');"
    print -- ""
    print -- "SELECT routine_catalog, routine_schema, routine_name, routine_type"
    print -- "FROM \`${qp}\`.\`region-eu\`.\`INFORMATION_SCHEMA\`.\`ROUTINES\`"
    print -- "WHERE LOWER(routine_definition) LIKE LOWER('%${src_tbl}%');"
    print -- ""
  done
} >| "$drop_file"

print ""
print -P "%F{yellow}=== DROP instructions for ${#pending_drop} undeleted source(s) (NOT executed) ===%f"
cat "$drop_file"
print ""
print -P "%F{yellow}Drop instructions written to:%f $drop_file"

(( ${#delete_failed} > 0 )) && archive_rc=1
(( ${#views_delete_failed} > 0 )) && archive_rc=1
return $archive_rc
