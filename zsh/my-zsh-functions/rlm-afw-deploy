emulate -L zsh
set -o pipefail

# ---------------------------------------------------------------------------
# Locate project root
#
# The project root is the directory that contains BOTH `airflow_manager/`
# and `pyproject.toml` (typically `.../airflow/` in the orchestration repo).
# Walk up from $PWD so the function works when invoked from any subdirectory
# inside the project (e.g. `airflow/airflow_manager/dag_folder/`).
# ---------------------------------------------------------------------------

local project_root="" dir="$PWD"
while [[ $dir != / && -n $dir ]]; do
  if [[ -d "$dir/airflow_manager" && -f "$dir/pyproject.toml" ]]; then
    project_root="$dir"
    break
  fi
  dir=${dir:h}
done

if [[ -z $project_root ]]; then
  print -u2 "afw-deploy: project root not found (walked up from \$PWD looking for a directory containing both 'airflow_manager/' and 'pyproject.toml')"
  return 1
fi

if [[ $PWD != $project_root ]]; then
  print "afw-deploy: cd $project_root" >&2
  cd "$project_root" || return 1
fi

if ! command -v uv >/dev/null 2>&1; then
  print -u2 "afw-deploy: 'uv' not found in PATH"
  return 1
fi

if ! command -v fzf >/dev/null 2>&1; then
  print -u2 "afw-deploy: 'fzf' not found in PATH"
  return 1
fi

if ! command -v fd >/dev/null 2>&1; then
  print -u2 "afw-deploy: 'fd' not found in PATH"
  return 1
fi

# Verify `uv run afw` resolves to the project venv (not a stray $PATH
# afw) and auto-install if not. Shared helper handles the three-line
# diagnostic on hard failure.
#
# The project is uv-managed (uv.lock is tracked; the Justfile drives
# everything through `uv run`). uv also honours `requires-python`
# (>=3.11,<3.12, pinned to the Cloud Composer 3 image) and will fetch a
# managed interpreter when no compatible one is installed — poetry
# instead errors out and demands a manual `env use`.
autoload -Uz _rlm-uv-ensure-venv
_rlm-uv-ensure-venv "$PWD" afw afw-deploy || return 1

# ---------------------------------------------------------------------------
# Cache: remember last selections per project root
# ---------------------------------------------------------------------------

local cache_dir="$HOME/.cache/afw-deploy"
mkdir -p "$cache_dir"

# Use a hash of the absolute project root as the cache key so each project
# gets its own last-selection file.
local project_root cache_key cache_file
project_root=$(pwd)
cache_key=$(print -n "$project_root" | md5)
cache_file="${cache_dir}/${cache_key}.txt"

# Read previous selection (if any) to use as the fzf default. The cache may
# hold several DAGs (one per line, since the picker is multi-select); the
# query pre-fill only needs the first entry.
local default_dag=""
if [[ -f $cache_file ]]; then
  default_dag=$(head -n 1 "$cache_file")
fi

# ---------------------------------------------------------------------------
# Determine, for the picker, two sets of DAG files:
#
#   local_set   — files with uncommitted edits in the working tree (staged
#                 or unstaged vs HEAD). Shown yellow, sorted first.
#   changed_set — files committed in this branch vs the merge-base with the
#                 repository's default branch (origin/HEAD), EXCLUDING the
#                 locally-edited ones. Shown green, sorted second.
#
# Everything else is unhighlighted (default color), sorted last. Failure
# here is non-fatal: the picker still works, just without the highlighting /
# sort-changed-first behavior.
# ---------------------------------------------------------------------------

typeset -A changed_set local_set
local changed_ok=0
if git rev-parse --git-dir >/dev/null 2>&1; then
  local default_branch fork_point git_root cwd_rel changed_file
  default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')
  if [[ -z $default_branch ]]; then
    default_branch=$(git remote show origin 2>/dev/null | awk '/HEAD branch/ {print $NF}')
  fi
  if [[ -n $default_branch ]]; then
    fork_point=$(git merge-base --fork-point "origin/${default_branch}" 2>/dev/null)
    if [[ -z $fork_point ]]; then
      fork_point=$(git merge-base HEAD "origin/${default_branch}" 2>/dev/null)
    fi
  fi
  if [[ -n $fork_point ]]; then
    git_root=$(git rev-parse --show-toplevel)
    cwd_rel=${PWD#"${git_root}/"}
    [[ $PWD == $git_root ]] && cwd_rel=""

    # Helper: convert a repo-root-relative path to cwd-relative (matching
    # what `fd` emits below). Sets reply; returns 1 if outside cwd.
    _afw_to_cwd_rel() {
      local p=$1
      if [[ -n $cwd_rel ]]; then
        case $p in
          "${cwd_rel}/"*) p=${p#${cwd_rel}/} ;;
          *) return 1 ;;
        esac
      fi
      reply=$p
      return 0
    }

    # Locally-edited files: working tree (and index) differing from HEAD.
    while IFS= read -r changed_file; do
      [[ -z $changed_file ]] && continue
      _afw_to_cwd_rel "$changed_file" || continue
      local_set[$reply]=1
    done < <(git diff --name-only HEAD 2>/dev/null)

    # Branch-touched files vs the fork point; drop any already in local_set
    # so each file lands in exactly one group.
    while IFS= read -r changed_file; do
      [[ -z $changed_file ]] && continue
      _afw_to_cwd_rel "$changed_file" || continue
      [[ -n ${local_set[$reply]} ]] && continue
      changed_set[$reply]=1
    done < <(git diff --name-only "$fork_point" 2>/dev/null)

    unfunction _afw_to_cwd_rel
    changed_ok=1
  fi
fi

# ---------------------------------------------------------------------------
# Build the picker input: DAG files sorted with branch-changed first, then
# by mtime (newer first). Each line carries two hidden sort-key columns
# plus a colored display column and a raw-path column, tab-separated.
# fzf's --with-nth shows only the display column and --delimiter lets us
# read the raw path back from the selection without any ANSI round-trip.
# ---------------------------------------------------------------------------

local -a dag_files
dag_files=(${(f)"$(fd -t f --max-depth 1 dag.py airflow_manager/dag_folder)"})

if (( ${#dag_files} == 0 )); then
  print -u2 "afw-deploy: no dag.py files found under airflow_manager/dag_folder/"
  return 1
fi

# Detect stat flavor for mtime epoch (macOS vs GNU).
local stat_fmt
if stat -f %m / >/dev/null 2>&1; then
  stat_fmt=(-f %m)   # BSD/macOS
else
  stat_fmt=(-c %Y)   # GNU/Linux
fi

# Each picker line: "<group>\t<-mtime>\t<display>\t<raw-path>"
#   group:   0 = locally edited (yellow), 1 = branch-touched (green),
#            2 = unchanged (default). Lower group sorts first.
#   -mtime:  negative epoch so plain numeric sort yields newer-first
#   display: path with ANSI color per group (shown by fzf)
#   raw:     unstyled path (read back from fzf via --delimiter / cut)
local -a picker_lines
local f mtime group display
local yellow=$'\e[33m' green=$'\e[32m' reset=$'\e[0m'
for f in $dag_files; do
  mtime=$(stat $stat_fmt "$f" 2>/dev/null) || mtime=0
  if (( changed_ok )) && [[ -n ${local_set[$f]} ]]; then
    group=0
    display="${yellow}${f}${reset}"
  elif (( changed_ok )) && [[ -n ${changed_set[$f]} ]]; then
    group=1
    display="${green}${f}${reset}"
  else
    group=2
    display="$f"
  fi
  picker_lines+=("${group}	-${mtime}	${display}	${f}")
done

picker_lines=(${(f)"$(printf '%s\n' "${picker_lines[@]}" | sort -t$'\t' -k1,1n -k2,2n)"})

# ---------------------------------------------------------------------------
# fzf picker over DAG files (multi-select)
#
# --multi lets the user tag several DAGs (tab / shift-tab to toggle, or the
# ctrl-a / ctrl-d binds below to select/deselect all). Each selected line is
# returned on its own line; we read the raw-path column (4th tab-separated
# field) back from every one.
# ---------------------------------------------------------------------------

local picker_out
picker_out=$(
  printf '%s\n' "${picker_lines[@]}" \
  | fzf \
      --multi \
      --no-mouse \
      --ansi \
      --delimiter=$'\t' \
      --with-nth=3 \
      --prompt="Select DAG(s)> " \
      --header="tab: toggle · ctrl-a: all · ctrl-d: none · enter: deploy" \
      --height=80% \
      --reverse \
      ${default_dag:+--query="$(basename "$default_dag")"} \
      --preview='cat {4}' \
      --preview-window=bottom:40%:wrap \
      --bind="ctrl-p:change-preview-window(bottom:70%:wrap|bottom:40%:wrap|hidden)" \
      --bind='ctrl-a:select-all' \
      --bind='ctrl-d:deselect-all' \
      --bind='ctrl-g:abort'
)

# Extract the raw-path column (4th tab-separated field) from each selected
# line. With --multi, picker_out holds one selection per line.
local -a dag_files_selected dag_names
local sel
for sel in ${(f)picker_out}; do
  [[ -z $sel ]] && continue
  dag_files_selected+=("${sel##*$'\t'}")
done

if (( ${#dag_files_selected} == 0 )); then
  print -u2 "afw-deploy: no DAG selected, aborting"
  return 1
fi

# afw's -d/--dags option takes a DAG *filename* (foo_dag.py) and is
# `multiple=True`, so pass one -d per selected DAG in a single invocation.
local dag_file
local -a dag_args
for dag_file in $dag_files_selected; do
  local dag_name
  dag_name=$(basename "$dag_file")
  dag_names+=("$dag_name")
  dag_args+=(-d "$dag_name")
done

# Persist the full selection for next time (newline-separated; the query
# pre-fill below uses only the first entry).
print -l -- "${dag_files_selected[@]}" >| "$cache_file"

# ---------------------------------------------------------------------------
# Deploy (single invocation; afw stops on the first DAG that fails)
#
# The target bucket is deliberately NOT passed with -b. afw resolves it itself
# (Sandbox.__resolve_composer_bucket) from the live Composer environment, which
# is the only source that stays correct across environment recreations.
#
# This used to hardcode -b europe-west1-sdp-composer-91ff48c9-bucket, the DAG
# bucket of the pre-Composer-3 environment. After the sdp-composer ->
# sdp-composer3 migration that bucket still EXISTS and still accepts uploads,
# so deploys kept reporting "Done!" while writing to a bucket no scheduler
# reads — the deployed DAG simply never became effective. Verified at the time
# of this change: the old bucket's ecerulm_dags.zip was minutes old while the
# live environment's was a week stale.
# ---------------------------------------------------------------------------

local env subnetwork
env="dev"
subnetwork="${DBT_DATASET_PREFIX:-ecerulm}"

local project="storytel-data-platform-${env}"

# Snapshot each DAG's current parse time BEFORE uploading, so the wait below
# can tell a genuine re-parse from Composer's periodic one. Best-effort: an
# empty baseline just makes the wait rely on the GCS-generation floor alone.
local baseline_file="" prev_gen=""
if [[ -z ${AFW_NO_WAIT:-} ]]; then
  autoload -Uz _rlm-afw-wait-parsed
  baseline_file=$(mktemp -t afw-baseline-XXXXXXXX 2>/dev/null)
  if [[ -n $baseline_file ]]; then
    _rlm-afw-wait-parsed snapshot \
      --project "$project" --sandbox "$subnetwork" >| "$baseline_file" 2>/dev/null
  fi
  # Pre-deploy generation of the DAG zip. If this is unchanged afterwards then
  # nothing was uploaded to the bucket this environment reads, and the wait
  # fails fast (rc 4) instead of blocking until a periodic re-parse fakes it.
  prev_gen=$(_rlm-afw-wait-parsed generation \
    --project "$project" --sandbox "$subnetwork" 2>/dev/null)
fi

print "afw-deploy: deploying ${(j:, :)dag_names} to env=${env} …" >&2

# `date +%s` rather than $EPOCHSECONDS: the latter needs zmodload zsh/datetime,
# which is not loaded here (verified), and would silently expand to empty.
local deploy_started=$(date +%s)
uv run afw sandbox deploy \
  -e "$env" \
  -s "$subnetwork" \
  "${dag_args[@]}"
local deploy_rc=$?

if (( deploy_rc != 0 )); then
  [[ -n $baseline_file ]] && rm -f "$baseline_file"
  print -u2 "afw-deploy: deploy failed (exit $deploy_rc); not waiting."
  return $deploy_rc
fi

# ---------------------------------------------------------------------------
# Wait for the new code to actually become effective in Composer.
#
# `afw` returns as soon as the zip is uploaded to GCS; the scheduler picks it
# up on its own schedule, so there is a window where the deploy "succeeded"
# but the old DAG code is still live. Skip with AFW_NO_WAIT=1; tune with
# AFW_WAIT_TIMEOUT / AFW_WAIT_INTERVAL.
# ---------------------------------------------------------------------------

if [[ -n ${AFW_NO_WAIT:-} ]]; then
  print -u2 "afw-deploy: AFW_NO_WAIT set — skipping the parse wait."
  return 0
fi

autoload -Uz _rlm-afw-wait-parsed
_rlm-afw-wait-parsed \
  --project "$project" \
  --sandbox "$subnetwork" \
  --since "$deploy_started" \
  ${baseline_file:+--baseline "$baseline_file"} \
  ${prev_gen:+--prev-generation "$prev_gen"} \
  --timeout "${AFW_WAIT_TIMEOUT:-300}" \
  --interval "${AFW_WAIT_INTERVAL:-10}" \
  "${dag_names[@]}"
local wait_rc=$?

[[ -n $baseline_file ]] && rm -f "$baseline_file"
return $wait_rc
