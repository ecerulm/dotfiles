# pr-worktree-rm-merged-closed: clean up stale git worktrees, either for the
# current repo (single-repo mode) or for every repo sitting side-by-side under
# the current directory (multi-repo mode). Mode is auto-detected:
#
#   * inside a git repo  -> single-repo mode (operates on that repo only).
#   * otherwise, if the cwd holds one or more primary git repos (child dirs
#     with a `.git` DIRECTORY, i.e. not worktree checkouts) -> multi-repo
#     mode, gathering worktrees across all of them.
#   * otherwise, if the cwd holds git WORKTREES (i.e. it is itself one of the
#     collection dirs described below) -> the same multi-repo mode, over the
#     primary repos those worktrees belong to. Running from inside a
#     collection is therefore equivalent to running from the base dir.
#
# It opens ONE fzf multi-select picker listing worktrees across every repo in
# scope (except each repo's main/primary worktree and, in single-repo mode,
# the current one). Each row is flagged with its deletion category so you can
# eyeball what's safe to drop:
#
#   [merged#N] / [closed#N]  the branch has a GitHub PR in that state; any
#                            leftover changes are stale rebase/merge debris.
#   [no-pr/no-diff]          no PR and no commits ahead of the default branch;
#                            the worktree was created but never worked on.
#   [open#N]                 open PR -- has active work; deletable but flagged.
#   [has-work]               no PR but commits ahead of the default branch.
#
# COLLECTIONS. rlm-pr-worktree's multi-repo mode creates a whole SET of
# sibling worktrees -- one per repo -- inside a single collection dir next to
# the repos' parent, e.g.
#
#   ~/git/work/StorytelDataPlatform_20260727_DATA-2770-foo/
#     data-platform-dbt/  data-platform-infra/  ...
#
# `git worktree list` reports those wherever they live, so they always
# appeared here, but as raw absolute paths and only ever one row at a time.
# They now render relative to the repos' grandparent and each collection gets
# ONE aggregate row standing for the whole set:
#
#   [7 wt: 5 merged, 2 open]  StorytelDataPlatform_20260727_DATA-2770-foo/
#   [merged#123]                └ data-platform-dbt
#   [open#456]                  └ data-platform-infra
#
# The aggregate's state counts are always listed in the same canonical order
# (merged, closed, no-pr/no-diff, open, has-work, detached) so the summaries
# line up when scanning several collection rows.
#
# Selecting the aggregate deletes EVERY worktree in it (whatever their
# individual states -- the flag summary is there so you can see what you're
# about to drop) and then `rmdir`s the collection dir. rmdir, not rm -rf: if
# a removal failed or the dir holds anything else, it refuses and the dir is
# kept. Members stay individually selectable; picking both an aggregate and
# one of its members deletes that member once. The aggregate counts as
# deletable (and so sorts to the top, dragging its members with it) only when
# every member is deletable.
#
# Deletable rows ([merged]/[closed]/[no-pr/no-diff]) are sorted to the top.
# TAB multi-selects, ENTER deletes the selection, Ctrl-G aborts (deletes
# nothing). Preview pane is the shared ~/bin/wt-preview (aggregates preview
# their member list instead).
#
# After the picker (or in --dry-run), it prints a table of the REMAINING
# worktrees showing how stale each is:
#
#   REPO  WORKTREE  BRANCH  BEHIND  AHEAD  AGE  CREATED
#
# where BEHIND/AHEAD are commits vs the repo's default branch (origin/HEAD,
# fallback main), AGE is the last-commit date on the branch, and CREATED is
# the worktree directory birthtime. Each repo's main worktree is shown as a
# reference row labeled (main).
#
# Each worktree is removed with `git worktree remove`; on failure it retries
# with `--force`. `git worktree prune` runs once per affected repo.
#
# Flags:
#   --dry-run, -n   Skip the picker; just print the deletable set and the
#                   remaining-worktrees table. Deletes nothing.
#   --yes, -y       Accepted for backwards compatibility but ignored: the
#                   picker is inherently interactive.
#
# Usage:
#   pr-worktree-rm-merged-closed             # single picker (single or multi repo)
#   pr-worktree-rm-merged-closed --dry-run   # tables only, no deletion
#
# Requires: gh, git, fzf, jq

emulate -L zsh
set -o pipefail

local yes=0 dry_run=0
local arg
for arg in "$@"; do
  case $arg in
    -y | --yes) yes=1 ;;
    -n | --dry-run) dry_run=1 ;;
    -h | --help)
      print -- "usage: pr-worktree-rm-merged-closed [--dry-run|-n] [--yes|-y]"
      return 0
      ;;
    *)
      print -u2 "pr-worktree-rm-merged-closed: unknown arg: $arg"
      return 1
      ;;
  esac
done
: "$yes"                                                 # accepted but ignored (picker is interactive)

for cmd in gh git fzf jq; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    print -u2 "pr-worktree-rm-merged-closed: '$cmd' not found in PATH"
    return 1
  fi
done

# ----- display path for a worktree ---------------------------------------
# _prwtrmc_rel_path <wt_abs> <repo_root>
#   Shorten an absolute worktree path for display. Worktrees live in two
#   places:
#
#     * siblings of the repo         -> <repo-parent>/<repo>-<date>-<tail>
#     * inside a sibling COLLECTION  -> <repo-grandparent>/<coll>_<date>_<tail>/<repo>
#       dir created by rlm-pr-worktree's multi-repo mode
#
#   Stripping only ${repo_root:h} (the repo's parent) handles the first case
#   but leaves the second as a full absolute path, because the collection dir
#   is a sibling of the repo's PARENT, not of the repo. Try the parent first,
#   then the grandparent, so collection worktrees render as
#   "StorytelDataPlatform_20260727_DATA-2770-foo/data-platform-dbt".
_prwtrmc_rel_path() {
  local wt_abs=$1 repo_root=$2
  local parent=${repo_root:h}
  local grandparent=${parent:h}
  local rel=${wt_abs#${parent}/}
  [[ $rel != "$wt_abs" ]] && { print -r -- "$rel"; return 0; }
  rel=${wt_abs#${grandparent}/}
  print -r -- "$rel"
}

# ----- collection dir for a worktree --------------------------------------
# _prwtrmc_collection_of <wt_abs> <repo_root>
#   Print the absolute path of the multi-repo COLLECTION directory holding
#   this worktree, or nothing when the worktree isn't in one.
#
#   A collection worktree sits at <grandparent>/<coll>/<repo-name>, i.e. its
#   parent is a sibling of the repo's own parent. Sibling worktrees of the
#   repo itself (<parent>/<repo>-<date>-<tail>) have the repo's parent as
#   their parent, so they're correctly excluded.
_prwtrmc_collection_of() {
  local wt_abs=$1 repo_root=$2
  local parent=${repo_root:h}
  local wt_parent=${wt_abs:h}
  [[ $wt_parent == "$parent" ]] && return 0     # plain sibling worktree
  [[ ${wt_parent:h} == "${parent:h}" ]] && print -r -- "$wt_parent"
  return 0
}

# ----- progress reporting -------------------------------------------------
# The scan is network-bound (a fetch + a PR search per repo) and takes tens of
# seconds across a full set of repos, so it has to say what it's doing.
#
# Everything goes to STDERR, never stdout: the picker rows are assembled on
# stdout and piped into fzf, so a stray progress line there becomes a bogus
# selectable row. (Same class of bug as the `local` re-declaration note below.)
#
# When stderr is a TTY, each phase line is rewritten in place with \r and a
# clear-to-EOL, so a long run shows one updating line instead of a wall of
# output. When it isn't (piped, redirected, CI), fall back to plain lines so
# the log stays readable.
_prwtrmc_progress() {
  [[ -n $PRWTRMC_QUIET ]] && return 0
  if [[ -t 2 ]]; then
    print -nu2 -- $'\r\e[2K'"$*"
  else
    print -u2 -- "$*"
  fi
}

# End an in-place progress sequence so the next output starts on a fresh line.
_prwtrmc_progress_done() {
  [[ -n $PRWTRMC_QUIET ]] && return 0
  [[ -t 2 ]] && print -nu2 -- $'\r\e[2K'
  return 0
}

# ----- humanize seconds ("<N><unit> ago") --------------------------------
# Same ladder as ~/bin/wt-preview's _wt_human_ago, compact units.
_prwtrmc_human_ago() {
  local secs=$1
  [[ -z $secs ]] && { print -r -- ""; return 0; }
  (( secs < 0 )) && secs=0
  if   (( secs < 60       )); then print -r -- "${secs}s ago"
  elif (( secs < 3600     )); then print -r -- "$(( secs / 60 ))m ago"
  elif (( secs < 86400    )); then print -r -- "$(( secs / 3600 ))h ago"
  elif (( secs < 2592000  )); then print -r -- "$(( secs / 86400 ))d ago"
  elif (( secs < 31536000 )); then print -r -- "$(( secs / 2592000 ))mo ago"
  else                             print -r -- "$(( secs / 31536000 ))y ago"
  fi
}

# ----- directory birthtime (created) epoch -------------------------------
# macOS: stat -f %B; GNU: stat -c %W, falling back to ctime (%Z). Empty on
# failure or a zero birthtime. Mirrors wt-preview's fallback chain.
_prwtrmc_created_epoch() {
  local dir=$1 epoch=""
  if stat -f '%B' "$dir" >/dev/null 2>&1; then
    epoch=$(stat -f '%B' "$dir" 2>/dev/null)
  else
    epoch=$(stat -c '%W' "$dir" 2>/dev/null)
    if [[ -z $epoch || $epoch == 0 || $epoch == "-" ]]; then
      epoch=$(stat -c '%Z' "$dir" 2>/dev/null)
    fi
  fi
  [[ $epoch == 0 ]] && epoch=""
  print -r -- "$epoch"
}

# ----- collect picker rows for one repo -----------------------------------
# _prwtrmc_collect_repo <repo_root>
#   Fetches origin/<default>, builds the branch->pr_state map, walks the repo's
#   worktrees and appends a picker row per worktree to the outer `rows` array.
#   Row (tab-separated):
#     col1=display  col2=branch  col3=rel_path  col4=abs_path
#     col5=deletable(0/1)  col6=repo_root
#   fzf shows col1 (--with-nth=1); preview uses col4; deletion uses col4/col6.
_prwtrmc_collect_repo() {
  local repo_root=$1
  local repo_label=${repo_root:t}

  # Identify the main/primary worktree (first porcelain entry).
  local main_worktree
  main_worktree=$(git -C "$repo_root" worktree list --porcelain \
    | awk '/^worktree /{print $2; exit}')

  # The current worktree only matters in single-repo mode; in multi-repo mode
  # the cwd is the parent dir and won't match any worktree, so this is a no-op.
  local current_worktree
  current_worktree=$(git rev-parse --show-toplevel 2>/dev/null) || current_worktree=""

  # Default branch (origin/HEAD, fallback main).
  local def_branch
  def_branch=$(git -C "$repo_root" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
    | sed 's|refs/remotes/origin/||')
  [[ -z $def_branch ]] && def_branch=main

  # Refresh origin/<def> so the ahead check + later behind/ahead are current.
  _prwtrmc_progress "[${repo_label}] fetching origin/${def_branch}…"
  git -C "$repo_root" fetch --quiet origin "$def_branch" 2>/dev/null

  # ----- branch -> "<state>#<number>" PR map ------------------------------
  # Ask GitHub only about the branches this repo actually has worktrees for,
  # via one `--search "head:a head:b …"` query (the terms OR together).
  #
  # This replaces a `gh pr list --limit 500` bulk fetch, which was both slow
  # and WRONG on a busy repo: 500 PRs no longer reach back far enough, so any
  # worktree whose PR predated the window fell through to a per-branch `gh`
  # call — one extra round trip each, and a silent mislabel as "no PR" when
  # that fallback was also skipped. Measured on data-platform-dbt (19
  # worktrees): ~6.8s of gh time before, ~0.8s after, same 13 PRs resolved.
  #
  # EVERY worktree branch is queried, including ones with no
  # refs/remotes/origin/<branch>. An earlier version filtered those out on the
  # theory that "a branch that was never pushed cannot have a PR" — true, but a
  # branch whose PR was MERGED and whose remote branch was then deleted looks
  # identical locally, and that is the single most common state for a worktree
  # this tool is meant to clean up. The filter therefore hid exactly the PRs it
  # exists to find: the merged ones fell through to the commits-ahead check and
  # came back "[has-work]" (a merge-commit landing renders the branch N ahead of
  # main), so the more finished a PR was, the more likely it was flagged as
  # unfinished. Measured on data-platform-dbt: 8 of 11 worktree branches were
  # being skipped. The filter also saved nothing — it is one batched call either
  # way: 3 branches 0.82s / 7 PRs vs 11 branches 0.89s / 11 PRs.
  local -a wt_branches
  local b_line
  while IFS= read -r b_line; do
    [[ -n $b_line ]] && wt_branches+=("$b_line")
  done < <(git -C "$repo_root" worktree list --porcelain \
    | awk '/^branch refs\/heads\//{sub("branch refs/heads/","");print}')

  local -a query_branches=("${wt_branches[@]}")

  local -A pr_state
  if (( ${#query_branches} )); then
    _prwtrmc_progress "[${repo_label}] querying ${#query_branches} branch(es) for PRs…"

    # Batch the terms. No ceiling was hit at 60 terms / 2.6KB, but the search
    # API does cap query length, and a silent truncation would mislabel real
    # PRs as "no PR" — the one failure mode this map must not have.
    local -i batch=40 start=1
    local pr_json search_q
    local map_branch map_state map_number
    while (( start <= ${#query_branches} )); do
      local -a chunk=("${(@)query_branches[start,start+batch-1]}")
      search_q="${(j: :)${(@)chunk/#/head:}}"
      pr_json=$(cd -- "$repo_root" 2>/dev/null \
        && gh pr list --state all --limit 200 \
             --json number,state,headRefName \
             --search "$search_q" 2>/dev/null) \
        || pr_json='[]'
      [[ -z $pr_json ]] && pr_json='[]'

      # `head:` is a PREFIX match, not an exact one: head:DATA-2792 also
      # returns DATA-2792/feat/partition_config. Keep only exact headRefName
      # hits, or a worktree inherits a sibling branch's PR state — which for a
      # merged sibling would wrongly mark it deletable.
      while IFS=$'\t' read -r map_branch map_state map_number; do
        [[ -z $map_branch ]] && continue
        (( ${wt_branches[(Ie)$map_branch]} )) || continue
        # Several PRs can share a head branch; keep the highest number (most
        # recent), matching what `gh pr view <branch>` would report.
        local prev=${pr_state[$map_branch]:-}
        if [[ -n $prev ]] && (( ${prev#*#} >= map_number )); then
          continue
        fi
        pr_state[$map_branch]="${(L)map_state}#${map_number}"
      done < <(print -r -- "$pr_json" \
        | jq -r '.[] | [.headRefName, .state, .number] | @tsv' 2>/dev/null)

      start=$(( start + batch ))
    done
  fi

  local wt_path="" wt_branch=""

  _prwtrmc_row() {
    local wt_abs=$1 branch=$2
    [[ $wt_abs == "$main_worktree" ]] && return 0
    [[ -n $current_worktree && $wt_abs == "$current_worktree" ]] && return 0

    local rel_path
    rel_path=$(_prwtrmc_rel_path "$wt_abs" "$repo_root")

    local flag="[has-work]" deletable=0

    if [[ -z $branch ]]; then
      flag="[detached]"                                  # detached HEAD: not deletable here
    else
      local entry=${pr_state[$branch]:-}
      # The batch search above asked about every worktree branch, so reaching
      # here usually means there really is no PR. Confirm with a single
      # `gh pr view` rather than trusting a negative from a search index that
      # can lag just-opened PRs.
      #
      # Gated on the branch having commits the default branch does not, which
      # is the only state where a wrong answer changes the verdict: with 0
      # ahead the row is "[no-pr/no-diff]" and already deletable, so a PR we
      # failed to find would not move it. Branches that ARE ahead are the ones
      # that get mislabelled "[has-work]" when a lookup is skipped, so those
      # are worth a round trip.
      #
      # Do NOT gate this on refs/remotes/origin/<branch> existing. A merged
      # branch whose remote was deleted has no such ref, and is precisely the
      # case that must resolve — see the batch-search comment above.
      local ahead_probe=''
      if [[ -z $entry ]]; then
        ahead_probe=$(git -C "$repo_root" rev-list --count \
          "origin/${def_branch}..${branch}" 2>/dev/null) || ahead_probe=''
      fi
      if [[ -z $entry ]] && (( ${ahead_probe:-0} > 0 )); then
        local pr_check
        pr_check=$(cd -- "$repo_root" 2>/dev/null \
          && gh pr view "$branch" --json number,state 2>/dev/null) \
          || pr_check=''
        if [[ -n $pr_check && $pr_check != '[]' ]]; then
          local pr_st pr_num
          pr_st=$(print -r -- "$pr_check" | jq -r '.state // empty' 2>/dev/null)
          pr_num=$(print -r -- "$pr_check" | jq -r '.number // empty' 2>/dev/null)
          [[ -n $pr_st ]] && entry="${(L)pr_st}#${pr_num}"
        fi
      fi

      if [[ -n $entry ]]; then
        local st=${entry%#*} num=${entry#*#}
        flag="[${st}#${num}]"
        [[ $st == merged || $st == closed ]] && deletable=1
      else
        # Truly no PR: deletable only if no commits ahead of the default branch.
        local ahead
        ahead=$(git -C "$repo_root" rev-list --count "origin/${def_branch}..${branch}" 2>/dev/null) \
          || ahead=""
        if [[ -n $ahead ]] && (( ahead == 0 )); then
          flag="[no-pr/no-diff]"
          deletable=1
        fi
      fi
    fi

    # Collection dir (multi-repo worktree set) this worktree belongs to, or
    # empty for a plain sibling worktree. Used to synthesize aggregate rows.
    local coll
    coll=$(_prwtrmc_collection_of "$wt_abs" "$repo_root")

    # Display column bundles the flag with the path so it shows in the picker
    # (fzf renders only col1 via --with-nth=1). rel_path already carries the
    # repo dir prefix, so the row is self-identifying across repos. Members of
    # a collection are indented under their aggregate row.
    local display label=$rel_path
    [[ -n $coll ]] && label="  └ ${wt_abs:t}"
    display=$(printf '%-18s %s' "$flag" "$label")
    rows+=("$(printf '%s\t%s\t%s\t%s\t%d\t%s\t%s\t%s' \
      "$display" "${branch:-<detached>}" "$rel_path" "$wt_abs" "$deletable" "$repo_root" "$coll" "$flag")")
  }

  while IFS= read -r line; do
    case $line in
      worktree\ *)
        wt_path=${line#worktree }
        wt_branch=""
        ;;
      branch\ *)
        wt_branch=${line#branch refs/heads/}
        ;;
      "")
        [[ -n $wt_path ]] && _prwtrmc_row "$wt_path" "$wt_branch"
        wt_path=""
        wt_branch=""
        ;;
    esac
  done < <(git -C "$repo_root" worktree list --porcelain)
  [[ -n $wt_path ]] && _prwtrmc_row "$wt_path" "$wt_branch"
}

# ----- print the remaining-worktrees table for one repo -------------------
# _prwtrmc_table_repo <repo_root>
#   Appends one table row per worktree (including main, labeled) to the outer
#   `table_rows` array. Recomputes behind/ahead/age/created from live state.
_prwtrmc_table_repo() {
  local repo_root=$1
  local repo_name=${repo_root:t}

  local main_worktree
  main_worktree=$(git -C "$repo_root" worktree list --porcelain \
    | awk '/^worktree /{print $2; exit}')

  local def_branch
  def_branch=$(git -C "$repo_root" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
    | sed 's|refs/remotes/origin/||')
  [[ -z $def_branch ]] && def_branch=main

  local wt_path="" wt_branch=""

  _prwtrmc_table_row() {
    local wt_abs=$1 branch=$2
    local rel_path
    rel_path=$(_prwtrmc_rel_path "$wt_abs" "$repo_root")

    local is_main=0
    [[ $wt_abs == "$main_worktree" ]] && is_main=1

    local behind="-" ahead="-" age="-" created="-"

    if [[ -n $branch ]]; then
      local ba
      ba=$(git -C "$repo_root" rev-list --left-right --count \
        "origin/${def_branch}...${branch}" 2>/dev/null) || ba=""
      if [[ -n $ba ]]; then
        behind=${ba%%$'\t'*}
        ahead=${ba##*$'\t'}
      fi
      local commit_epoch
      commit_epoch=$(git -C "$repo_root" log -1 --format=%ct "$branch" 2>/dev/null) || commit_epoch=""
      if [[ -n $commit_epoch ]]; then
        local now; now=$(date +%s)
        age=$(_prwtrmc_human_ago $(( now - commit_epoch )))
      fi
    fi

    local created_epoch
    created_epoch=$(_prwtrmc_created_epoch "$wt_abs")
    if [[ -n $created_epoch ]]; then
      local now2; now2=$(date +%s)
      created=$(_prwtrmc_human_ago $(( now2 - created_epoch )))
    fi

    local label_branch=${branch:-<detached>}
    (( is_main )) && label_branch="${label_branch} (main)"

    table_rows+=("$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s' \
      "$repo_name" "$rel_path" "$label_branch" "$behind" "$ahead" "$age" "$created")")
  }

  while IFS= read -r line; do
    case $line in
      worktree\ *) wt_path=${line#worktree }; wt_branch="" ;;
      branch\ *)   wt_branch=${line#branch refs/heads/} ;;
      "")          [[ -n $wt_path ]] && _prwtrmc_table_row "$wt_path" "$wt_branch"
                   wt_path=""; wt_branch="" ;;
    esac
  done < <(git -C "$repo_root" worktree list --porcelain)
  [[ -n $wt_path ]] && _prwtrmc_table_row "$wt_path" "$wt_branch"
}

# ----- determine repos in scope -------------------------------------------
local -a repos
local cwd_repo
cwd_repo=$(git rev-parse --show-toplevel 2>/dev/null)

if [[ -n $cwd_repo ]]; then
  # Single-repo mode.
  repos=("$cwd_repo")
else
  # Multi-repo mode: scan cwd for primary git repos (child dir with a .git DIR).
  local d
  for d in *(/N); do
    [[ -d $d/.git ]] && repos+=("${d:A}")
  done
  repos=("${(@o)repos}")                                 # sort

  # Collection mode. Standing INSIDE a collection dir found nothing above,
  # because a collection's children are worktree CHECKOUTS -- their `.git` is a
  # file, not a directory -- so the primary-repo test rejects all of them and
  # the function used to bail with "no primary git repos found". But that dir
  # is exactly where you are when you finish a multi-repo change set and want
  # to clean it up, and the intent there is the same as running from the base
  # dir: operate on the whole family.
  #
  # Resolve each child worktree to the primary repo backing it via
  # --git-common-dir (that path is the repo's .git dir, so :h is the repo
  # root). Using git's own record rather than a dirname convention means this
  # keeps working for a renamed collection, and it yields precisely the repo
  # set the base dir would have produced -- making this equivalent to `cd`ing
  # there first, which is the point. Collections whose members span several
  # base dirs resolve to all of them, which is still the right answer.
  if (( ${#repos} == 0 )); then
    local common
    for d in *(/N); do
      common=$(git -C "$d" rev-parse --git-common-dir 2>/dev/null) || continue
      [[ -n $common ]] || continue
      # --git-common-dir may be relative to the worktree it was run from.
      [[ $common != /* ]] && common="$d/$common"
      common=${common:A}
      # Ignore anything not backed by a real .git dir (e.g. a bare stray).
      [[ ${common:t} == .git && -d $common ]] || continue
      repos+=("${common:h}")
    done
    # Members of one collection are one-per-repo, but dedupe defensively:
    # a duplicate repo would collect the same worktrees twice.
    repos=("${(@ou)repos}")
  fi

  if (( ${#repos} == 0 )); then
    print -u2 "pr-worktree-rm-merged-closed: not inside a git repo, and no primary git repos or worktrees found under $PWD"
    return 1
  fi
fi

# ----- collect all picker rows across every repo in scope -----------------
local -a rows
local repo
local -i repo_i=0
for repo in "${repos[@]}"; do
  repo_i=$(( repo_i + 1 ))
  _prwtrmc_progress "[${repo_i}/${#repos}] scanning ${repo:t}…"
  _prwtrmc_collect_repo "$repo"
done
_prwtrmc_progress_done

# ----- synthesize one aggregate row per multi-repo collection -------------
# rlm-pr-worktree's multi-repo mode creates a whole set of sibling worktrees
# (one per repo) inside a single collection dir. Cleaning one up means
# selecting every member individually and then rmdir'ing the leftover dir, so
# add ONE aggregate row per collection that stands for the entire set.
#
# The aggregate's flag summarizes its members ("[7 wt: 5 merged, 2 open]");
# selecting it deletes ALL of them and removes the (then-empty) collection
# dir. It is marked deletable only when every member is, so fully-stale
# collections still sort to the top of the picker.
#
# Aggregate row layout mirrors a worktree row but marks col4 (the path fzf
# previews and the deletion loop consumes) empty and carries the collection
# path in col7 — the deletion loop branches on that.
local -A coll_total coll_deletable coll_flags
local r_coll r_del r_flag
local rrow
for rrow in "${rows[@]}"; do
  local -a f
  f=("${(@s:	:)rrow}")
  r_del=${f[5]}
  r_coll=${f[7]}
  r_flag=${f[8]}
  [[ -z $r_coll ]] && continue
  coll_total[$r_coll]=$(( ${coll_total[$r_coll]:-0} + 1 ))
  coll_deletable[$r_coll]=$(( ${coll_deletable[$r_coll]:-0} + r_del ))
  # Strip the "#<number>" so PRs of different numbers fold into one bucket.
  local bare=${r_flag//[\[\]]/}
  bare=${bare%%\#*}
  coll_flags[$r_coll]="${coll_flags[$r_coll]:-} $bare"
done

local -a agg_rows
local ckey
for ckey in "${(@k)coll_total}"; do
  local total=${coll_total[$ckey]}
  local ndel=${coll_deletable[$ckey]}

  # Only aggregate a collection this run actually covers in full. In
  # single-repo mode (or any run whose scope is a subset of the collection's
  # repos) we see just one member, while the dir still holds the other repos'
  # worktrees — an aggregate there would promise to remove the whole
  # collection and then fail the rmdir, since the dir isn't empty. Compare
  # against what's on disk rather than against ${#repos}: a collection may
  # predate a repo being added to (or removed from) the parent dir.
  local on_disk=0                                  # explicit init: see loop-local note below
  on_disk=$(ls -1 -- "$ckey" 2>/dev/null | grep -cv '^\.' 2>/dev/null) || on_disk=0
  if (( total < on_disk )); then
    continue
  fi

  # Count each distinct member state. The summary lists states in a FIXED
  # canonical order (deletable-first, then the states that need attention),
  # not in the order members happened to be walked: an aggregate's flag is
  # read at a glance across many rows, so the columns have to line up
  # semantically. First-seen order made the same collection render
  # "[7 wt: 6 no-pr/no-diff, 1 merged]" or "[7 wt: 1 merged, 6 no-pr/no-diff]"
  # depending on repo iteration order. Any state not in the list (a future
  # flag) is appended after, sorted, so it still shows up.
  #
  # These MUST be reset explicitly each iteration: `local` inside a function
  # body scopes to the whole function, not to the enclosing loop, so a bare
  # `local -A state_count` re-declares the same variable and keeps the
  # previous collection's counts — every aggregate would otherwise inherit
  # and accumulate the tallies of the ones before it.
  local -A state_count=()
  local st=''
  for st in ${=coll_flags[$ckey]}; do
    state_count[$st]=$(( ${state_count[$st]:-0} + 1 ))
  done
  local -a state_order=(merged closed no-pr/no-diff open has-work detached)
  local -a extra=()
  for st in "${(@ko)state_count}"; do
    (( ${state_order[(Ie)$st]} )) || extra+=("$st")
  done
  state_order+=("${extra[@]}")
  local -a parts=()
  for st in "${state_order[@]}"; do
    (( ${state_count[$st]:-0} )) && parts+=("${state_count[$st]} ${st}")
  done
  local summary="${(j:, :)parts}"

  local agg_del=0
  (( ndel == total )) && agg_del=1
  local agg_flag="[${total} wt: ${summary}]"
  # NOTE: `local x=...` with an explicit initializer, never a bare `local x`,
  # because these run inside a loop — see the zsh gotcha in AGENTS.md: a bare
  # re-declaration of an already-declared name switches typeset into reporting
  # mode and PRINTS "x=<value>" to stdout on every iteration after the first,
  # which lands straight in the picker's input.
  local agg_display=''
  agg_display=$(printf '%-18s %s' "$agg_flag" "${ckey:t}/")
  agg_rows+=("$(printf '%s\t%s\t%s\t%s\t%d\t%s\t%s\t%s' \
    "$agg_display" "<collection>" "${ckey:t}/" "" "$agg_del" "" "$ckey" "$agg_flag")")
done
(( ${#agg_rows} )) && rows+=("${agg_rows[@]}")

# Collections that got an aggregate row. Members of a collection WITHOUT one
# (suppressed above because this run only sees part of it) must behave like
# standalone worktrees: sort by their own flag, render their full relative
# path rather than an orphaned "└ name", and never be swept up by a
# collection selection.
local -A coll_has_agg
local arow
for arow in "${agg_rows[@]}"; do
  local -a af
  af=("${(@s:	:)arow}")
  coll_has_agg[${af[7]}]=1
done

if (( ${#coll_has_agg} < ${#coll_total} )); then
  local -a fixed=()
  for rrow in "${rows[@]}"; do
    local -a xf
    xf=("${(@s:	:)rrow}")
    if [[ -n ${xf[7]} && -n ${xf[4]} && -z ${coll_has_agg[${xf[7]}]} ]]; then
      # Re-render as a standalone row: full relative path, no collection link.
      xf[1]=$(printf '%-18s %s' "${xf[8]}" "${xf[3]}")
      xf[7]=''
      fixed+=("${(pj:\t:)xf}")
    else
      fixed+=("$rrow")
    fi
  done
  rows=("${fixed[@]}")
fi

# Sort deletable rows (col5=1) first, then by display. Prefix an inverted
# deletable flag (1-col5) so deletable rows (key 0) sort ahead of others.
#
# Collection members must stay grouped directly under their aggregate rather
# than scattering by their own flag, so the sort key for any row belonging to
# a collection is derived from the COLLECTION: key2 = "<coll>" for the
# aggregate and "<coll> <member>" for its members. That sorts the aggregate
# first (shorter prefix) with its members immediately after, and makes the
# whole group's position depend on the aggregate's deletable flag, not each
# member's. Non-collection rows keep sorting by their own display text.
#
# Keys are computed here in zsh rather than in awk because the group flag
# lives in the coll_* associative arrays already built above; awk would need
# a second pass to see aggregates (which are appended after their members).
local -a keyed
for rrow in "${rows[@]}"; do
  local -a kf
  kf=("${(@s:	:)rrow}")
  local k_abs=${kf[4]} k_del=${kf[5]} k_coll=${kf[7]}
  local key1='' key2=''                            # explicit init: see loop-local note above
  if [[ -z $k_coll ]]; then                        # standalone worktree
    key1=$(( 1 - k_del ))
    key2=${kf[1]}
  elif [[ -z $k_abs ]]; then                       # collection aggregate
    key1=$(( 1 - k_del ))
    key2=$k_coll
  else                                             # member of a collection
    local gdel=0
    (( ${coll_deletable[$k_coll]:-0} == ${coll_total[$k_coll]:-0} )) && gdel=1
    key1=$(( 1 - gdel ))
    key2="${k_coll} ${k_abs}"
  fi
  keyed+=("$(printf '%d\t%s\t%s' "$key1" "$key2" "$rrow")")
done

local -a sorted
if (( ${#keyed} )); then
  sorted=("${(@f)$(
    printf '%s\n' "${keyed[@]}" \
      | sort -t$'\t' -k1,1n -k2,2 \
      | cut -f3-
  )}")
fi

# ----- single picker (or dry-run listing) ---------------------------------
local -a del_paths del_display del_repos del_colls
if (( ${#sorted} == 0 )); then
  print "No removable worktrees found (excluding each repo's main/current)."
elif (( dry_run )); then
  # Keep a member row whenever its COLLECTION is deletable, even if that one
  # member isn't (an aggregate deletes all of them). Filtering purely on each
  # row's own flag would print members orphaned from their aggregate header
  # and hide members that the aggregate would in fact remove.
  local r
  local -a would
  for r in "${sorted[@]}"; do
    local -a df
    df=("${(@s:	:)r}")
    local d_abs=${df[4]} d_del=${df[5]} d_coll=${df[7]}
    if [[ -n $d_coll && -n $d_abs ]]; then         # collection member
      (( ${coll_deletable[$d_coll]:-0} == ${coll_total[$d_coll]:-0} )) \
        && would+=("${df[1]}")
    elif [[ $d_del == 1 ]]; then                   # aggregate or standalone
      would+=("${df[1]}")
    fi
  done
  if (( ${#would} )); then
    print "would delete (dry-run):"
    printf '  %s\n' "${would[@]}"
  else
    print "(dry-run: nothing deletable)"
  fi
else
  local selection
  selection=$(
    printf '%s\n' "${sorted[@]}" \
      | fzf --multi --ansi --no-mouse --height=80% --reverse \
            --delimiter=$'\t' --with-nth=1 \
            --prompt='delete> ' \
            --header='TAB multi-select | ENTER delete | Ctrl-G abort (a collection row deletes all its worktrees + the dir)' \
            --preview='
              if [ -n "{4}" ]; then
                "$HOME/bin/wt-preview" {4}
              else
                printf "COLLECTION %s\n\n" "{7}"
                echo "A multi-repo worktree set created by pr-worktree."
                echo "Selecting this row deletes EVERY worktree below and then"
                echo "removes the collection directory itself."
                echo ""
                ls -1 "{7}" 2>/dev/null | sed "s/^/  /"
              fi
            ' \
            --preview-window=bottom:40%:wrap \
            --bind='ctrl-p:change-preview-window(bottom:70%:wrap|bottom:40%:wrap|hidden)' \
            --bind='ctrl-g:abort'
  )
  if [[ -n $selection ]]; then
    # An aggregate row (empty col4) stands for every worktree in its
    # collection, so expand it into its member rows. Selecting both an
    # aggregate and one of its members must not queue that member twice —
    # `queued` dedupes on the absolute worktree path.
    #
    # Split each line with "${(@s:<tab>:)line}", NOT `IFS=$'\t' read`. read
    # collapses runs of the delimiter, so an aggregate row — which carries an
    # empty col4 (no single worktree path) and an empty col6 (no single repo
    # root) — has its `\t\t` read as ONE separator and every later field
    # shifts left. col4 then holds the deletable flag ("1") and col6 the
    # display flag string, so the deletion loop ran `git -C '[7 wt: …]'` and
    # died with "cannot change to '[7 wt: …]': No such file or directory".
    # The (@s) split preserves empty fields positionally.
    local -A queued sel_colls
    local selline
    for selline in "${(@f)selection}"; do
      [[ -z $selline ]] && continue
      local -a sf
      sf=("${(@s:	:)selline}")
      local sel_rel=${sf[3]} sel_abs=${sf[4]} sel_repo=${sf[6]} sel_coll=${sf[7]}
      if [[ -z $sel_abs ]]; then
        [[ -n $sel_coll ]] && sel_colls[$sel_coll]=1
        continue
      fi
      [[ -n ${queued[$sel_abs]} ]] && continue
      queued[$sel_abs]=1
      del_paths+=("$sel_abs")
      del_display+=("$sel_rel")
      del_repos+=("$sel_repo")
    done

    # Pull in every member of each selected collection.
    if (( ${#sel_colls} )); then
      local mrow
      for mrow in "${rows[@]}"; do
        local -a mf
        mf=("${(@s:	:)mrow}")
        local m_rel=${mf[3]} m_abs=${mf[4]} m_repo=${mf[6]} m_coll=${mf[7]}
        [[ -z $m_abs ]] && continue                  # skip aggregates
        [[ -z $m_coll || -z ${sel_colls[$m_coll]} ]] && continue
        [[ -n ${queued[$m_abs]} ]] && continue
        queued[$m_abs]=1
        del_paths+=("$m_abs")
        del_display+=("$m_rel")
        del_repos+=("$m_repo")
      done
      del_colls=("${(@k)sel_colls}")
    fi
  fi
fi

# ----- perform deletions (grouped implicitly by carrying repo per row) -----
local failed=0 i
local -A pruned
if (( ${#del_paths} )); then
  print
  print "About to delete ${#del_paths} worktree(s):"
  for (( i = 1; i <= ${#del_display}; i++ )); do print "  ${del_display[$i]}"; done
  if (( ${#del_colls} )); then
    print "…and remove ${#del_colls} collection dir(s):"
    local cshow
    for cshow in "${del_colls[@]}"; do print "  ${cshow:t}/"; done
  fi
  print -n "Proceed? [y/N] "
  local reply
  read -r reply
  if [[ ${reply:l} == y || ${reply:l} == yes ]]; then
    # Removals are SERIAL, deliberately. The cost here is not git but
    # unlink(): a worktree carries a .venv of ~18k files (518MB of the 581MB
    # total in data-platform-dbt), so a single `git worktree remove` spends
    # ~5s in the kernel deleting files.
    #
    # Parallelising this does NOT help, which is worth recording so it doesn't
    # get "optimised" again. Measured on 7 worktrees x 6k files: 8.71s serial
    # vs 8.74s parallel — and with git taken out of the picture entirely,
    # plain `rm -rf` gave 8.705s vs 8.743s. Concurrency is *safe* (8 parallel
    # removes against one repo all exit 0; git locks .git/worktrees/ itself),
    # it just buys nothing: APFS serialises the metadata mutations, so the
    # background jobs queue on the same lock and only the CPU accounting
    # changes (system time 0.39s -> 5.13s at identical wall clock).
    #
    # Batching is not an option either: `git worktree remove` takes exactly
    # one worktree per invocation, and the syscall count would be unchanged.
    local -i nremove=${#del_paths}
    local -i ndone=0
    for (( i = 1; i <= ${#del_paths}; i++ )); do
      local p=${del_paths[$i]}
      local d=${del_display[$i]}
      local rr=${del_repos[$i]}
      local err=''                                 # explicit init: see loop-local note above

      # Sanity-gate the two paths before handing them to git. A row that was
      # parsed wrong (see the (@s) split note above) would otherwise become
      # `git -C '<garbage>'`, which fails with a confusing "cannot change to
      # …" and — because the repo root was also recorded in `pruned` — repeats
      # the same error from the prune pass afterwards.
      if [[ -z $rr || ! -d $rr ]]; then
        print -u2 "failed:  $d (bad repo root: '${rr}')"
        failed=$(( failed + 1 ))
        continue
      fi

      # Each removal is seconds of silent unlink()ing, so name the one in
      # flight rather than letting the terminal sit idle.
      ndone=$(( ndone + 1 ))
      _prwtrmc_progress "[${ndone}/${nremove}] removing ${d}…"

      if git -C "$rr" worktree remove "$p" 2>/dev/null; then
        _prwtrmc_progress_done
        print "removed: $d"
      elif err=$(git -C "$rr" worktree remove --force "$p" 2>&1); then
        _prwtrmc_progress_done
        print "removed (force): $d"
      else
        _prwtrmc_progress_done
        print -u2 "failed:  $d ($p)"
        [[ -n $err ]] && print -u2 "  force: $err"
        failed=$(( failed + 1 ))
      fi
      pruned[$rr]=1
    done
    _prwtrmc_progress_done

    local pr
    for pr in "${(@k)pruned}"; do
      git -C "$pr" worktree prune
    done

    # Remove the now-empty collection dirs. Deliberately `rmdir`, not
    # `rm -rf`: if a worktree removal failed, or the dir holds anything we
    # didn't put there, rmdir refuses and nothing is destroyed. macOS also
    # leaves a .DS_Store behind, so clear that one known-disposable file
    # first, then let rmdir arbitrate.
    local cdir
    for cdir in "${del_colls[@]}"; do
      [[ -d $cdir ]] || continue
      [[ -f $cdir/.DS_Store ]] && rm -f -- "$cdir/.DS_Store"
      if rmdir -- "$cdir" 2>/dev/null; then
        print "removed dir: ${cdir:t}/"
      else
        print -u2 "kept dir (not empty): $cdir"
        local leftover=''                          # explicit init: see loop-local note above
        leftover=$(ls -A -- "$cdir" 2>/dev/null | head -5)
        [[ -n $leftover ]] && print -u2 "$leftover" | sed 's/^/  /' >&2
        failed=$(( failed + 1 ))
      fi
    done
  else
    print "Aborted (nothing deleted)."
  fi
fi

# ----- remaining-worktrees table (combined, across all repos) -------------
local -a table_rows
repo_i=0
for repo in "${repos[@]}"; do
  repo_i=$(( repo_i + 1 ))
  _prwtrmc_progress "[${repo_i}/${#repos}] computing status for ${repo:t}…"
  _prwtrmc_table_repo "$repo"
done
_prwtrmc_progress_done

if (( ${#table_rows} )); then
  print
  print "Remaining worktrees:"
  {
    print -- $'REPO\tWORKTREE\tBRANCH\tBEHIND\tAHEAD\tAGE\tCREATED'
    printf '%s\n' "${table_rows[@]}"
  } | column -t -s $'\t'
fi

return $failed
