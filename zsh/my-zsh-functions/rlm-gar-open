emulate -L zsh
set -o pipefail
setopt local_options no_monitor no_notify

autoload -Uz _rlm-gar-preflight _rlm-gar-pick-package _rlm-gar-history \
             _rlm-gar-parse-image

local -a projects
projects=("${(@f)$(_rlm-gar-preflight gar-open)}") || return 1
projects=("${(@)projects:#}")
(( ${#projects} == 0 )) && return 1

local selection
selection=$(_rlm-gar-pick-package gar-open "GAR image> " \
              "$HOME/bin/gar-preview" 0 "${projects[@]}")
local pick_rc=$?
(( pick_rc != 0 )) && return $pick_rc
[[ -z $selection ]] && return 130

_rlm-gar-history append "$selection"

local loc_host proj repo pkg_path location_slug pkg_encoded console_url
eval "$(_rlm-gar-parse-image "$selection")" || return 1

print -r -- "$selection"
print -r -- "$console_url"

if command -v pbcopy >/dev/null 2>&1; then
  print -n -- "$console_url" | pbcopy
  print -u2 "gar-open: URL copied to clipboard"
elif command -v xclip >/dev/null 2>&1; then
  print -n -- "$console_url" | xclip -selection clipboard
  print -u2 "gar-open: URL copied to clipboard"
elif command -v xsel >/dev/null 2>&1; then
  print -n -- "$console_url" | xsel --clipboard --input
  print -u2 "gar-open: URL copied to clipboard"
fi

if command -v open >/dev/null 2>&1; then
  open "$console_url"
elif command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$console_url"
fi
