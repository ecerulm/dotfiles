emulate -L zsh
set -o pipefail

# ---------------------------------------------------------------------------
# Precondition checks
# ---------------------------------------------------------------------------

if ! command -v ssh-add >/dev/null 2>&1; then
  print -u2 -r -- "yubikey-ssh-add: 'ssh-add' not found in PATH"
  return 1
fi

# The macOS ssh-agent only loads PKCS#11 providers under /usr/lib or
# /usr/local/lib (after resolving symlinks), so the Homebrew path is refused.
local lib=/usr/local/lib/libykcs11.dylib

if [[ ! -f $lib || -L $lib ]]; then
  print -u2 -r -- "yubikey-ssh-add: $lib missing or a symlink; copy it with:"
  print -u2 -r -- "  sudo mkdir -p /usr/local/lib && sudo cp \"\$(realpath /opt/homebrew/lib/libykcs11.dylib)\" $lib"
  return 1
fi

# ---------------------------------------------------------------------------
# Main logic
# ---------------------------------------------------------------------------

# Without a YubiKey plugged in, ssh-add -s still asks for the PIN and then
# fails, so check the USB bus first. ioreg reports idVendor in decimal:
# 4176 is Yubico's 0x1050. -q keeps this silent for shell startup.
if ! ioreg -p IOUSB -l -w0 | grep -q '"idVendor" = 4176$'; then
  [[ $1 == -q ]] || print -u2 -r -- "yubikey-ssh-add: no YubiKey detected, skipping"
  return 0
fi

# Skip the PIN prompt when the agent can already sign with the YubiKey key.
local pub=~/.ssh/yubikey-9a.pub
if [[ -f $pub ]] && ssh-add -T "$pub" >/dev/null 2>&1; then
  print -r -- "yubikey-ssh-add: key already loaded"
  ssh-add -l
  return 0
fi

# Re-adding an already loaded provider is refused, and a replugged key leaves
# a stale entry behind, so drop any previous registration first.
ssh-add -e "$lib" >/dev/null 2>&1

ssh-add -s "$lib" || return 1
ssh-add -l
