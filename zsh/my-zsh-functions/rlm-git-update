emulate -L zsh
set -o pipefail

# ---------------------------------------------------------------------------
# rlm-git-update — bring every git repo in a directory up to date with
# origin/<branch> by merging it into whatever branch is checked out.
#
# Stays on the current branch. The point is to pick up upstream work without
# losing the branch you are on, so nothing is ever discarded:
#
#   - Repos with uncommitted *tracked* changes are skipped. git merge refuses
#     to run over a dirty tree anyway, and stopping early gives a clearer
#     message than git's. Untracked files do not block the run.
#   - Merges that would conflict are aborted and reported. The repo is left
#     exactly as it was, for the human to merge by hand.
#   - Local commits are preserved — a merge commit is created when the
#     branches have diverged, rather than rewriting history.
#   - Detached HEADs are skipped: there is no branch to merge into.
#
# Fetches before merging: merging a stale cached origin/<branch> would report
# success while leaving the repo behind.
#
# Directory handling mirrors rlm-git-status — scan the immediate children of
# <directory> (default cwd), and fall back to the target itself when it is a
# repo with no repo children — so the two compose over the same multi-repo
# collection dirs. rlm-git-status is invoked at the end to show where every
# repo landed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Precondition checks
# ---------------------------------------------------------------------------

if ! command -v git >/dev/null 2>&1; then
  print -u2 "git-update: 'git' not found in PATH"
  return 1
fi

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

local target=''
local target_branch='main'
local -i dry_run=0

while (( $# )); do
  case $1 in
    -n|--dry-run) dry_run=1; shift ;;
    -b|--branch)
      if [[ -z $2 ]]; then
        print -u2 "git-update: --branch requires an argument"
        return 2
      fi
      target_branch=$2; shift 2 ;;
    -h|--help)
      print -r -- "rlm-git-update [-n|--dry-run] [-b|--branch <name>] [<directory>]"
      print -r -- ""
      print -r -- "Merge origin/<branch> (default: main) into the branch checked out in"
      print -r -- "every repo under <directory> (default: cwd), then show rlm-git-status."
      print -r -- "Repos that would conflict are left untouched and reported."
      return 0 ;;
    --) shift; break ;;
    -*)
      print -u2 "git-update: unknown option '$1'"
      return 2 ;;
    *)
      if [[ -n $target ]]; then
        print -u2 "git-update: unexpected extra argument '$1'"
        return 2
      fi
      target=$1; shift ;;
  esac
done

[[ -z $target && -n $1 ]] && target=$1

target=${target:-$PWD}

if [[ ! -d $target ]]; then
  print -u2 "git-update: '$target' is not a directory"
  return 1
fi

target=${target:A}

# ---------------------------------------------------------------------------
# Repo discovery
#
# A child counts as a member when it is its own git worktree root: git reports
# a toplevel AND that toplevel is the child itself. Without the second test a
# plain subdirectory of an enclosing repo would match, since rev-parse happily
# answers from any depth. Same guard as rlm-git-status.
# ---------------------------------------------------------------------------

local -a repos
local subdir='' top=''
for subdir in "$target"/*(N/); do
  top=$(cd "$subdir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || continue
  [[ -z $top ]] && continue
  [[ ${top:A} != ${subdir:A} ]] && continue
  repos+=("${subdir:A}")
done

# Fall back to the enclosing repo when the target has no repo children, so the
# function works from inside a single worktree (at any depth) too.
if (( ${#repos} == 0 )); then
  top=$(cd "$target" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
  if [[ -n $top ]]; then
    repos=("${top:A}")
  else
    print -u2 "git-update: no git repositories found in ${target/#$HOME/~}"
    return 1
  fi
fi

# ---------------------------------------------------------------------------
# Output styling — only when attached to a terminal, so the log stays
# pasteable when piped or redirected.
# ---------------------------------------------------------------------------

local bold='' red='' green='' yellow='' dim='' reset=''
if [[ -t 1 ]]; then
  bold=$'\e[1m'; red=$'\e[31m'; green=$'\e[32m'
  yellow=$'\e[33m'; dim=$'\e[2m'; reset=$'\e[0m'
fi

# ---------------------------------------------------------------------------
# Main loop
# ---------------------------------------------------------------------------

local -a updated uptodate skipped failed conflicted
local repo name current behind summary

_rlm_git_update_run() {
  if (( dry_run )); then
    print -r -- "    ${dim}would run: git ${@}${reset}"
    return 0
  fi
  git "$@"
}

for repo in $repos; do
  name=${repo:t}
  print -r -- "${bold}==> ${name}${reset}"

  if [[ -n $(git -C "$repo" status --porcelain --untracked-files=no 2>/dev/null) ]]; then
    print -r -- "    ${yellow}skipped: uncommitted changes to tracked files${reset}"
    git -C "$repo" status --short --untracked-files=no | sed 's/^/      /'
    skipped+=("$name")
    continue
  fi

  # A detached HEAD has no branch to merge into. Merging would leave the
  # result unreachable once HEAD moves, so skip rather than pretend.
  if ! current=$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null); then
    print -r -- "    ${yellow}skipped: detached HEAD (no branch to merge into)${reset}"
    skipped+=("$name")
    continue
  fi

  (( dry_run )) || print -r -- "    fetching"
  if ! _rlm_git_update_run -C "$repo" fetch --prune origin; then
    print -r -- "    ${red}failed: fetch${reset}"
    failed+=("$name")
    continue
  fi

  if ! git -C "$repo" rev-parse --verify -q "refs/remotes/origin/$target_branch" >/dev/null; then
    print -r -- "    ${red}failed: origin/$target_branch does not exist${reset}"
    failed+=("$name")
    continue
  fi

  # Nothing to do when origin/<branch> is already an ancestor of HEAD. Checked
  # explicitly so the common case reports "up to date" instead of a no-op merge.
  if git -C "$repo" merge-base --is-ancestor "origin/$target_branch" HEAD 2>/dev/null; then
    print -r -- "    ${green}up to date${reset} ${dim}($current already contains origin/$target_branch)${reset}"
    uptodate+=("$name")
    continue
  fi

  behind=$(git -C "$repo" rev-list --count "HEAD..origin/$target_branch" 2>/dev/null) || behind=0
  print -r -- "    merging origin/$target_branch into $current ${dim}($behind commit(s) behind)${reset}"

  # Probe with merge-tree before touching the working tree. --write-tree exits
  # non-zero on conflict, so a conflicting merge is detected without ever
  # starting one — no half-merged state to clean up, no --abort to get wrong.
  if ! git -C "$repo" merge-tree --write-tree "HEAD" "origin/$target_branch" >/dev/null 2>&1; then
    print -r -- "    ${yellow}cannot merge automatically: conflicts with origin/$target_branch${reset}"
    print -r -- "    ${yellow}merge by hand: git -C ${repo/#$HOME/~} merge origin/$target_branch${reset}"
    conflicted+=("$name ($current)")
    continue
  fi

  if ! _rlm_git_update_run -C "$repo" merge --no-edit "origin/$target_branch"; then
    # merge-tree said it was clean, so a failure here is something else
    # (hooks, a pre-existing MERGE_HEAD). Roll back so the repo is not left
    # mid-merge, then report.
    git -C "$repo" merge --abort 2>/dev/null
    print -r -- "    ${red}failed: merge${reset}"
    failed+=("$name")
    continue
  fi

  summary=$(git -C "$repo" log -1 --format='%h %s' 2>/dev/null)
  print -r -- "    ${green}ok${reset} ${dim}${summary}${reset}"
  updated+=("$name")
done

unfunction _rlm_git_update_run

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

print
print -r -- "${bold}Summary${reset}"
if (( dry_run )); then
  print -r -- "${dim}(dry run - nothing was changed)${reset}"
  print -r -- "${dim}Note: no fetch was performed, so the reports above are computed${reset}"
  print -r -- "${dim}against a possibly stale origin/$target_branch.${reset}"
fi
print -r -- "  ${green}merged:     ${#updated}${reset}"
print -r -- "  ${green}up to date: ${#uptodate}${reset}"
print -r -- "  ${yellow}conflicted: ${#conflicted}${reset}"
print -r -- "  ${yellow}skipped:    ${#skipped}${reset}"
print -r -- "  ${red}failed:     ${#failed}${reset}"

if (( ${#conflicted} )); then
  print
  print -r -- "${yellow}Could not merge automatically (merge these by hand):${reset}"
  printf '  %s\n' "${conflicted[@]}"
fi

if (( ${#skipped} )); then
  print
  print -r -- "${yellow}Skipped (commit or stash, then re-run):${reset}"
  printf '  %s\n' "${skipped[@]}"
fi

if (( ${#failed} )); then
  print
  print -r -- "${red}Failed:${reset}"
  printf '  %s\n' "${failed[@]}"
fi

# ---------------------------------------------------------------------------
# Status table
#
# Show where every repo ended up. Guarded on the function existing so the file
# stays usable if it is sourced without the rest of the function collection.
# ---------------------------------------------------------------------------

if (( $+functions[rlm-git-status] )) || command -v rlm-git-status >/dev/null 2>&1; then
  print
  rlm-git-status "$target"
fi

(( ${#failed} )) && return 1
return 0
