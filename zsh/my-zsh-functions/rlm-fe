emulate -L zsh
set -o pipefail

autoload -Uz _rlm-fe-history

# ---------------------------------------------------------------------------
# rlm-fe — fuzzy-edit. fzf picker over files reachable from the current
# directory (recursive), opened in $EDITOR.
#
# Ordering: a single timeline, newest first, rendered as a humanized age
# ("2 hours ago") in the first column. Each file's time is:
#
#   dirty (or untracked)  filesystem mtime  - when you actually edited it
#   clean (tracked)       git commit time   - when it last really changed
#   never in git          filesystem mtime
#
# then max()'d with the MRU pick time, so opening a file floats it to the
# top and it decays from there, interleaved with everything else. No
# pinned block; the visible order always matches the visible age column.
#
# Why not simply max(fs mtime, git time): in a fresh clone every file's
# fs mtime is the *checkout* timestamp, not an edit time — 500 sampled
# files in the storytelhomepage checkout share just 2 distinct mtimes.
# Taking the max would then stamp the entire tree with one meaningless
# value and destroy the ordering. fs mtime is only meaningful for a file
# git reports as modified, which is exactly when it beats the commit
# time; for a clean file the commit time is the real answer.
#
# The MRU cache stores full absolute paths (see _rlm-fe-history), so a
# file keeps its recency no matter which directory rlm-fe is invoked
# from; the display column is relative to the current directory.
# ---------------------------------------------------------------------------

for _cmd in fzf fd python3; do
  if ! command -v "$_cmd" >/dev/null 2>&1; then
    print -u2 "fe: '$_cmd' not found in PATH"
    return 1
  fi
done
unset _cmd

local base
# Resolve to the real path so it shares fd's absolute-path prefix
# (fd canonicalizes symlinked components like /tmp -> /private/tmp);
# otherwise os.path.relpath below produces ../.. noise in the display.
base=${PWD:A}

# Emit "<abs_path>\t<commit_epoch>" for every file touched by the current
# repo's history, using the newest commit that touched each path.
#
# One `git log --name-only` walk resolves every tracked file in a single
# process — far cheaper than a `git log -1` per file.
#
# GIT_NO_LAZY_FETCH=1 is mandatory, not an optimization. In a partial
# clone (`--filter=blob:none`, e.g. the storytelhomepage checkout) walking
# history makes git lazily fetch missing objects over the network one
# round-trip at a time: the same walk that takes 0.13s here hung for over
# three minutes there. With lazy fetch refused, git aborts at the first
# missing object — 1.16s, having still resolved ~78% of tracked files.
# The unresolved remainder simply fall back to filesystem mtime.
#
# git prints paths relative to the repo root, so prefix them with the
# root to produce the absolute paths the rest of this function keys on.
_fe_git_times() {
  local repo_root=''
  repo_root=$(git -C "$base" rev-parse --show-toplevel 2>/dev/null) || return 0
  [[ -n $repo_root ]] || return 0

  GIT_NO_LAZY_FETCH=1 git -C "$repo_root" log \
      --format="C%ct" --name-only --no-merges 2>/dev/null \
    | awk -v root="$repo_root" '
        /^C/ { epoch = substr($0, 2); next }
        NF   { if (!seen[$0]++) printf "%s/%s\t%s\n", root, $0, epoch }
      '
}

# Emit one absolute path per line for every file git considers dirty —
# modified, staged, or untracked. These are the files whose filesystem
# mtime reflects a real edit rather than the checkout; for everything
# else the commit time is the truthful "last changed" signal.
#
# `git status --porcelain` costs ~0.03s here and ~0.15s in the partial
# clone, so it runs unconditionally. -z gives NUL-terminated, *unquoted*
# paths, which is what makes filenames containing spaces, quotes, or
# non-ASCII bytes safe — the default format C-quotes those, and
# unescaping them here would be its own bug farm.
#
# The NUL records are converted to newlines with `tr` rather than read
# directly with awk's RS: macOS BWK awk does not support RS='\0'. It
# does not error — it reads the entire stream as ONE record, so a repo
# with 8 dirty files emitted exactly 1 path and every other dirty file
# was silently mis-sorted as clean. (Same family as the BWK awk traps
# already in AGENTS.md.) A filename containing a literal newline would
# split here, but that costs at most a spurious dirty entry, whereas
# C-quoting breaks every non-ASCII path.
#
# Rename entries are "R  <new>\0<old>": the record after the XY prefix
# is the new name, and the following record (the old name) is skipped.
_fe_dirty_files() {
  local repo_root=''
  repo_root=$(git -C "$base" rev-parse --show-toplevel 2>/dev/null) || return 0
  [[ -n $repo_root ]] || return 0

  GIT_NO_LAZY_FETCH=1 git -C "$repo_root" status --porcelain -z 2>/dev/null \
    | tr '\0' '\n' \
    | awk -v root="$repo_root" '
        skip { skip = 0; next }                 # consume a rename source
        NF {
          status = substr($0, 1, 2)
          printf "%s/%s\n", root, substr($0, 4)
          if (status ~ /^R/) skip = 1
        }
      '
}

# Emit candidate lines as
#   <picked_at>\t<age_human>\t<rel_display>\t<abs_path>
# sorted by combined time DESC, where combined time is
# max(fs mtime, git commit time, picked_at) — or 0 if none can be
# determined. picked_at is the epoch of the most-recent pick for that
# abs_path (from the shared history), or 0 if never picked; it is kept as
# field 1 so callers can still tell picked entries apart.
_fe_sorted_list() {
  local -a files
  # -H (hidden) -I (no-ignore) still skips .git/; pass an absolute base
  # so fd emits absolute paths that double as the MRU cache key.
  files=("${(@f)$(fd --hidden --no-ignore --type f --exclude .git --absolute-path . "$base")}")
  (( ${#files} == 0 )) && return 0

  local history_payload
  history_payload=$(_rlm-fe-history read)

  local git_payload
  git_payload=$(_fe_git_times)

  local dirty_payload
  dirty_payload=$(_fe_dirty_files)

  {
    print -r -- "$base"
    print -r -- "__HISTORY__"
    [[ -n $history_payload ]] && print -r -- "$history_payload"
    print -r -- "__GITTIMES__"
    [[ -n $git_payload ]] && print -r -- "$git_payload"
    print -r -- "__DIRTY__"
    [[ -n $dirty_payload ]] && print -r -- "$dirty_payload"
    print -r -- "__FILES__"
    printf '%s\n' "${files[@]}"
  } | python3 -c '
import os, sys, time

lines = sys.stdin.read().splitlines()
base = lines[0]
i = lines.index("__HISTORY__")
g = lines.index("__GITTIMES__")
d = lines.index("__DIRTY__")
j = lines.index("__FILES__")
history_lines = [l for l in lines[i+1:g] if l]
git_lines = [l for l in lines[g+1:d] if l]
dirty = set(l for l in lines[d+1:j] if l)
file_lines = [l for l in lines[j+1:] if l]

# git_lines: "<abs_path>\t<commit_epoch>", newest-commit-per-path already
# selected by the awk pass in _fe_git_times.
git_times = {}
for line in git_lines:
    parts = line.split("\t")
    if len(parts) < 2:
        continue
    try:
        git_times[parts[0]] = int(parts[1])
    except ValueError:
        pass

NOW = int(time.time())

def human_ago(epoch):
    """Largest unit that yields >= 1. Mirrors bin/wt-preview:_wt_human_ago."""
    if epoch <= 0:
        return "unknown"
    secs = NOW - epoch
    if secs < 0:
        secs = 0
    if secs < 60:
        return "%d second%s ago" % (secs, "" if secs == 1 else "s")
    if secs < 3600:
        n = secs // 60
        return "%d minute%s ago" % (n, "" if n == 1 else "s")
    if secs < 86400:
        n = secs // 3600
        return "%d hour%s ago" % (n, "" if n == 1 else "s")
    if secs < 2592000:
        n = secs // 86400
        return "%d day%s ago" % (n, "" if n == 1 else "s")
    if secs < 31536000:
        n = secs // 2592000
        return "%d month%s ago" % (n, "" if n == 1 else "s")
    n = secs // 31536000
    return "%d year%s ago" % (n, "" if n == 1 else "s")

# history_lines: "<epoch>\t<command>\t<abs_path>", newest first, already
# deduped per abs_path by _rlm-fe-history. picked_at = epoch.
picked_at = {}
for line in history_lines:
    parts = line.split("\t")
    if len(parts) < 3:
        continue
    try:
        epoch = int(parts[0])
    except ValueError:
        epoch = 0
    abs_path = parts[2]
    if abs_path not in picked_at:
        picked_at[abs_path] = epoch

rows = []
for abs_path in file_lines:
    try:
        fs_mtime = int(os.stat(abs_path).st_mtime)
    except OSError:
        fs_mtime = 0
    pa = picked_at.get(abs_path, 0)
    # Pick ONE change time rather than max()-ing fs and git together: in
    # a fresh clone every fs mtime is the checkout timestamp, so a max()
    # would stamp the whole tree with one value. fs mtime is only
    # meaningful when git says the file is actually dirty.
    git_epoch = git_times.get(abs_path, 0)
    if abs_path in dirty or git_epoch == 0:
        change_time = fs_mtime
    else:
        change_time = git_epoch
    # The MRU pick is a genuine "you touched this" event whenever it
    # happened, so it still competes on the same timeline.
    mtime = max(change_time, pa)
    rel = os.path.relpath(abs_path, base)
    sort_key = mtime
    rows.append((sort_key, pa, human_ago(mtime), rel, abs_path))

rows.sort(key=lambda r: r[0], reverse=True)

# Pad the age column so the filenames line up, and dim it so the paths
# stay the visually dominant field. Width is computed from the data
# rather than hardcoded ("15 seconds ago" is longer than "3 days ago").
width = max((len(r[2]) for r in rows), default=0)
DIM, RESET = "\033[2m", "\033[0m"
for _, pa, age, rel, abs_path in rows:
    print(f"{pa}\t{DIM}{age:<{width}}{RESET}\t{rel}\t{abs_path}")
'
}

local candidates
candidates=$(_fe_sorted_list) || return 1
if [[ -z $candidates ]]; then
  print -u2 "fe: no files found under ${base}"
  return 0
fi

local selection
selection=$(
  print -r -- "$candidates" \
    | fzf \
      --prompt="Files> " \
      --multi \
      --no-mouse \
      --ansi \
      --height=80% \
      --reverse \
      --delimiter=$'\t' \
      --with-nth=2,3 \
      --preview="$HOME/bin/fe-preview {4}" \
      --preview-window=bottom:40%:wrap \
      --header="TAB multi • Enter open • Shift/Alt-↑↓ scroll • Ctrl-P size • Ctrl-G abort" \
      --bind='ctrl-p:change-preview-window(bottom:70%:wrap|bottom:40%:wrap|hidden)' \
      --bind='shift-up:preview-up' \
      --bind='shift-down:preview-down' \
      --bind='alt-up:preview-half-page-up' \
      --bind='alt-down:preview-half-page-down' \
      --bind='ctrl-g:abort'
) || return 130

[[ -z $selection ]] && return 0

# selection is one or more "<picked_at>\t<age>\t<rel>\t<abs_path>" lines
# (--multi). Extract field 4 (the full path) from each, record every
# pick in the MRU, then open them all in one $EDITOR invocation.
local -a picked
picked=("${(@f)$(print -r -- "$selection" | cut -f4)}")
(( ${#picked} == 0 )) && return 0

local p
for p in "${picked[@]}"; do
  [[ -n $p ]] && _rlm-fe-history append fe "$p"
done

printf '%s\n' "${picked[@]}"

${EDITOR:-vi} "${picked[@]}"
