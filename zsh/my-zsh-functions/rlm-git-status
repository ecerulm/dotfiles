emulate -L zsh
setopt extended_glob
unsetopt monitor notify
set -o pipefail

# ---------------------------------------------------------------------------
# rlm-git-status — status table across every git repo in a directory.
#
# Answers "where does this change set stand?" for the multi-repo collection
# dirs created by rlm-pr-worktree's multi-repo mode — one directory holding a
# worktree of every repo on a shared branch, e.g.
#   ~/git/work/StorytelDataPlatform_20260730_DATA-2770-widen-gar-cleanup/
#     {data-platform-dbt,data-platform-infra,...}
#
# One row per repo, four state columns, covering both the local and the
# outward-facing side of a change set:
#
#   AHEAD/BEHIND  commit divergence from the base branch, as +N/-N.
#                 Base is origin/<default> by default.
#   LOCAL         uncommitted work: staged / unstaged / untracked / conflicts.
#   PR            pull request for the branch, as an OSC 8 link.
#   JIRA          issue key from the branch (or the collection dirname).
#
# These are independent — a repo can be any combination of them, and
# collapsing to one "differs" boolean would hide the interesting cases (work
# committed but no PR; PR open but the tree is still dirty).
#
# Every repo gets a row. --changed narrows the table to repos that are dirty
# or diverged and collapses the rest onto a single dim "unchanged:" line,
# which is the useful view once a collection grows past a handful of repos.
#
# Scans children of the target dir. If the target is itself a git repo and
# has no repo children, it reports on just that repo, so the function is
# also usable as a plain `git status` summary from inside a worktree.
#
# PR lookups are the slow part (one `gh pr list` per repo, ~300-800ms each),
# so repos are probed in parallel and PRs can be skipped with --no-pr.
# JIRA summaries come from the same ~/.cache/wts-jira/<KEY>.summary cache
# that wt-preview and wt-collection-preview use, on the same 3-day TTL.
#
# rlm-git-repos is an alias for this function (it was a separate inventory
# view before the two were merged).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Precondition checks
# ---------------------------------------------------------------------------

if ! command -v git >/dev/null 2>&1; then
  print -u2 "git-status: 'git' not found in PATH"
  return 1
fi

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

local target=''
local base_override=''
local -i changed_only=0
local -i want_pr=1
local -i want_jira=1

while (( $# )); do
  case $1 in
    -c|--changed)
      changed_only=1
      shift
      ;;
    -a|--all)
      # Retained for compatibility: --all was how the pre-merge git-status
      # asked for every repo, which is now the default. Accepted as a no-op
      # so old muscle memory and any scripts keep working.
      changed_only=0
      shift
      ;;
    -b|--base)
      if [[ -z ${2:-} ]]; then
        print -u2 "git-status: --base requires an argument"
        return 1
      fi
      base_override=$2
      shift 2
      ;;
    -P|--no-pr)
      want_pr=0
      shift
      ;;
    -J|--no-jira)
      want_jira=0
      shift
      ;;
    -h|--help)
      print -r -- "usage: git-status [-c|--changed] [-b|--base <ref>] [-P|--no-pr] [-J|--no-jira] [<directory>]"
      return 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      print -u2 "git-status: unknown option: $1"
      return 1
      ;;
    *)
      if [[ -n $target ]]; then
        print -u2 "git-status: unexpected extra argument: $1"
        return 1
      fi
      target=$1
      shift
      ;;
  esac
done
[[ -z $target && $# -gt 0 ]] && { target=$1; shift; }
[[ -z $target ]] && target=$PWD

if [[ ! -d $target ]]; then
  print -u2 "git-status: not a directory: $target"
  return 1
fi
target=${target:A}

if (( want_pr )) && ! command -v gh >/dev/null 2>&1; then
  want_pr=0
fi
if (( want_pr )) && ! command -v jq >/dev/null 2>&1; then
  want_pr=0
fi

# ---------------------------------------------------------------------------
# Discover member repos
#
# A child counts as a member when it is its own git worktree root: git
# reports a toplevel AND that toplevel is the child itself. Without the
# second test a plain subdirectory of an enclosing repo would match, since
# rev-parse happily answers from any depth. Same guard as
# wt-collection-preview / _prl_discover_worktrees.
# ---------------------------------------------------------------------------

local -a members
local subdir='' top=''
for subdir in "$target"/*(N/); do
  top=$(cd "$subdir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || continue
  [[ -z $top ]] && continue
  [[ ${top:A} != ${subdir:A} ]] && continue
  members+=("${subdir:A}")
done

# Fall back to the target itself when it is a repo with no repo children,
# so `git-status` works from inside a single worktree too.
if (( ${#members} == 0 )); then
  top=$(cd "$target" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
  if [[ -n $top ]]; then
    members=("${top:A}")
  else
    print -u2 "git-status: no git repositories found in ${target/#$HOME/~}"
    return 1
  fi
fi

# ---------------------------------------------------------------------------
# Colors — only when stdout is a terminal, so the table stays pasteable
# when piped or redirected.
# ---------------------------------------------------------------------------

local bold='' dim='' green='' red='' yellow='' cyan='' blue='' reset=''
if [[ -t 1 ]]; then
  bold=$'\e[1m'
  dim=$'\e[2m'
  green=$'\e[32m'
  red=$'\e[31m'
  yellow=$'\e[33m'
  cyan=$'\e[36m'
  blue=$'\e[34m'
  reset=$'\e[0m'
fi

# ---------------------------------------------------------------------------
# Collect per-repo state
#
# Each repo is probed in a background job writing one TSV line to a tmpdir,
# so a 7-repo collection costs one round of wall-clock rather than seven.
# This matters most for the `gh pr list` call, which dominates: 7 repos
# serially is ~4s, in parallel ~700ms. MONITOR/NOTIFY are already off (top
# of file) so the fan-out does not print "[4] + done ..." pairs in an
# interactive shell.
#
# Row format (10 fields, any of which may be empty):
#   name \t branch \t base \t ahead \t behind \t local_summary \t dirty_flag
#     \t pr_num \t pr_state \t pr_url
# ---------------------------------------------------------------------------

local tmpdir
tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/rlm-git-status.XXXXXX") || {
  print -u2 "git-status: could not create temp directory"
  return 1
}

local -i idx=0
local m=''
for m in "${members[@]}"; do
  (( idx++ ))
  {
    local -i n=$idx
    local repo=$m
    local name=${repo:t}

    local branch=''
    branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null) || branch=''
    if [[ -z $branch ]]; then
      local short_sha=''
      short_sha=$(git -C "$repo" rev-parse --short HEAD 2>/dev/null) || short_sha=''
      branch="(detached${short_sha:+ $short_sha})"
    fi

    # Base ref: explicit override, else origin/<default>. origin/HEAD is
    # only present when the clone recorded it; fall back to origin/main.
    local base=''
    if [[ -n $base_override ]]; then
      base=$base_override
    else
      local default_branch=''
      default_branch=$(git -C "$repo" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
                        | sed 's|refs/remotes/origin/||')
      [[ -z $default_branch ]] && default_branch=main
      base="origin/${default_branch}"
    fi

    # Divergence. rev-list --left-right --count <base>...HEAD emits
    # "<behind>\t<ahead>": left = commits only on base, right = only on
    # HEAD. Empty when the base ref does not exist (fresh clone, renamed
    # default branch), which renders as "?" rather than a bogus 0/0.
    local ahead='' behind=''
    local counts=''
    if git -C "$repo" rev-parse --verify --quiet "$base" >/dev/null 2>&1; then
      counts=$(git -C "$repo" rev-list --left-right --count "${base}...HEAD" 2>/dev/null)
      if [[ -n $counts ]]; then
        behind=${counts%%[[:space:]]*}
        ahead=${counts##*[[:space:]]}
      fi
    fi

    # Working tree. porcelain=v2 gives stable two-char XY codes on the
    # "1"/"2" (ordinary/renamed) lines, "u" for unmerged and "?" for
    # untracked. X = staged, Y = unstaged; "." means unchanged in that
    # half, so a staged-only change is "M." and an unstaged-only ".M".
    local -i n_staged=0 n_unstaged=0 n_untracked=0 n_conflict=0
    local pline='' ptype='' xy=''
    while IFS= read -r pline; do
      [[ -z $pline ]] && continue
      ptype=${pline%% *}
      case $ptype in
        '?')
          (( n_untracked++ ))
          ;;
        'u')
          (( n_conflict++ ))
          ;;
        '1'|'2')
          xy=${${(s: :)pline}[2]}
          [[ ${xy[1]} != '.' ]] && (( n_staged++ ))
          [[ ${xy[2]} != '.' ]] && (( n_unstaged++ ))
          ;;
      esac
    done < <(git -C "$repo" status --porcelain=v2 2>/dev/null)

    local -a bits
    (( n_conflict  )) && bits+=("${n_conflict} conflict")
    (( n_staged    )) && bits+=("${n_staged} staged")
    (( n_unstaged  )) && bits+=("${n_unstaged} unstaged")
    (( n_untracked )) && bits+=("${n_untracked} untracked")

    local local_summary="${(j:, :)bits}"
    local -i dirty=0
    (( ${#bits} )) && dirty=1

    local pr_num='' pr_state='' pr_url=''
    if (( want_pr )) && [[ $branch != '(detached'* ]]; then
      local pr_json=''
      pr_json=$(cd "$repo" 2>/dev/null && gh pr list --state all --head "$branch" --limit 1 \
                  --json number,url,state 2>/dev/null)
      if [[ -n $pr_json && $pr_json != '[]' ]]; then
        # Parenthesize before `as`: jq binds `as` looser than `//`, so
        # `.[0] // {} as $pr | …` short-circuits and emits the raw input
        # whenever .[0] is truthy. See zsh/AGENTS.md.
        local pr_line=''
        pr_line=$(print -r -- "$pr_json" \
                  | jq -r '(.[0] // {}) as $pr
                           | [($pr.number // "" | tostring),
                              ($pr.state  // ""),
                              ($pr.url    // "")]
                           | @tsv' 2>/dev/null)
        if [[ -n $pr_line ]]; then
          local -a pf=()
          pf=("${(@s:	:)pr_line}")
          pr_num=${pf[1]}
          pr_state=${pf[2]}
          pr_url=${pf[3]}
        fi
      fi
    fi

    printf '%s\t%s\t%s\t%s\t%s\t%s\t%d\t%s\t%s\t%s\n' \
      "$name" "$branch" "$base" "$ahead" "$behind" "$local_summary" "$dirty" \
      "$pr_num" "$pr_state" "$pr_url" \
      >"$tmpdir/$n"
  } &
done
wait

# ---------------------------------------------------------------------------
# Read rows back in member order
#
# Split with the (@s) parameter flag, NOT `IFS=$'\t' read`: several fields
# are legitimately empty (a clean repo has no local_summary; a missing base
# ref leaves ahead/behind blank; most repos have no PR) and `read` collapses
# a run of delimiters into one, silently shifting every later field left.
# See zsh/AGENTS.md.
# ---------------------------------------------------------------------------

local -a rows rows_changed rows_clean unchanged_names
local -i n_changed=0
local raw='' fname=''

for (( idx = 1; idx <= ${#members}; idx++ )); do
  fname="$tmpdir/$idx"
  [[ -s $fname ]] || continue
  raw=$(<"$fname")
  raw=${raw%$'\n'}
  rows+=("$raw")

  local -a f=()
  f=("${(@s:	:)raw}")
  local name=${f[1]}
  local ahead=${f[4]} behind=${f[5]} dirty=${f[7]}

  # A repo is "changed" when it has uncommitted work OR has diverged from
  # the base in either direction. An unknown base (missing ref) also counts
  # — silence there would be indistinguishable from "in sync".
  local -i diverged=0
  if [[ -z $ahead || -z $behind ]]; then
    diverged=1
  elif (( ahead > 0 || behind > 0 )); then
    diverged=1
  fi

  if (( dirty || diverged )); then
    (( n_changed++ ))
    rows_changed+=("$raw")
  else
    rows_clean+=("$raw")
    unchanged_names+=("$name")
  fi
done

rm -rf "$tmpdir"

if (( ${#rows} == 0 )); then
  print -u2 "git-status: no repository state could be read"
  return 1
fi

# ---------------------------------------------------------------------------
# JIRA key + summary
#
# The key comes from the branch name; a collection dirname that embeds one
# (..._DATA-2770-widen-gar-cleanup) is the fallback, since every member of a
# collection shares it. Summaries reuse the ~/.cache/wts-jira/<KEY>.summary
# cache that wt-preview and wt-collection-preview populate, on the same
# 3-day TTL — so this function is usually a cache hit even the first time.
# ---------------------------------------------------------------------------

local coll_key=''
if [[ ${target:t} =~ '([A-Z][A-Z0-9]+-[0-9]+)' ]]; then
  coll_key=${match[1]}
fi

local -A jira_of
local row=''
if (( want_jira )); then
  for row in "${rows[@]}"; do
    local -a rf=()
    rf=("${(@s:	:)row}")
    local r_name=${rf[1]} r_branch=${rf[2]}
    local key=''
    if [[ $r_branch =~ '([A-Z][A-Z0-9]+-[0-9]+)' ]]; then
      key=${match[1]}
    else
      key=$coll_key
    fi
    jira_of[$r_name]=$key
  done
fi

# Refresh any key whose cache file is missing or stale. Done once per key
# after the fan-out rather than inside it: members of a collection share a
# key, so probing per repo would issue N identical `acli` calls.
local -A jira_summary
if (( want_jira )) && command -v acli >/dev/null 2>&1; then
  local -A seen_key
  local k=''
  for k in ${(v)jira_of}; do
    [[ -z $k ]] && continue
    [[ -n ${seen_key[$k]} ]] && continue
    seen_key[$k]=1

    local cache="$HOME/.cache/wts-jira/${k}.summary"
    local -i refresh=0
    if [[ ! -s $cache ]]; then
      refresh=1
    else
      local mtime='' now='' age=''
      now=$(date +%s)
      mtime=$(stat -f %m "$cache" 2>/dev/null || stat -c %Y "$cache" 2>/dev/null || print -r -- 0)
      age=$(( now - mtime ))
      (( age >= 259200 )) && refresh=1
    fi

    if (( refresh )); then
      mkdir -p "$HOME/.cache/wts-jira"
      local jraw=''
      jraw=$(acli jira workitem view "$k" -f summary,status 2>/dev/null) || jraw=''
      if [[ -n $jraw ]]; then
        local jsum='' jstat='' short=''
        jsum=$(print -r -- "$jraw" | awk -F': ' '/^Summary: /{sub(/^Summary: /,""); print; exit}')
        jstat=$(print -r -- "$jraw" | awk -F': ' '/^Status: /{sub(/^Status: /,""); print; exit}')
        short=$jsum
        (( ${#short} > 60 )) && short="${short:0:57}..."
        if [[ -n $jstat ]]; then
          printf '(%s) %s\n' "$jstat" "$short" >"$cache"
        else
          printf '%s\n' "$short" >"$cache"
        fi
      fi
    fi

    [[ -s $cache ]] && jira_summary[$k]=$(<"$cache")
  done
fi

# ---------------------------------------------------------------------------
# Render
# ---------------------------------------------------------------------------

local -a render_rows
if (( changed_only )); then
  render_rows=("${rows_changed[@]}")
else
  render_rows=("${rows[@]}")
fi

local repo_word='repos'
(( ${#members} == 1 )) && repo_word='repo'

printf '%s%s%s  %s(%d %s)%s\n' \
  "$bold" "${target/#$HOME/~}" "$reset" "$dim" "${#members}" "$repo_word" "$reset"

# A collection puts every member on one branch and one ticket, so repeating
# either per row is N copies of the same string — the JIRA summary alone is
# ~90 chars. Hoist any value shared by ALL rows into the header and drop its
# column. With 2+ repos only: for a single repo the header would just be the
# row restated.
#
# Computed over every row, not just the rendered ones, so --changed does not
# shift the branch/JIRA columns in and out depending on which repos are dirty.
local common_branch='' common_jira='' common_base=''
if (( ${#rows} > 1 )); then
  local -A branch_seen jira_seen
  for row in "${rows[@]}"; do
    local -a rf=()
    rf=("${(@s:	:)row}")
    branch_seen[${rf[2]}]=1
    jira_seen[${jira_of[${rf[1]}]:-}]=1
  done
  # Read the sole key via an array: ${(k)assoc[1]} does NOT mean "first key",
  # it subscripts by the literal key "1" and yields empty.
  local -a uniq_keys=()
  if (( ${#branch_seen} == 1 )); then
    uniq_keys=("${(@k)branch_seen}")
    common_branch=${uniq_keys[1]}
  fi
  if (( ${#jira_seen} == 1 )); then
    uniq_keys=("${(@k)jira_seen}")
    common_jira=${uniq_keys[1]}
  fi
fi

if [[ -n $common_branch ]]; then
  printf '%sbranch:%s %s%s%s\n' "$dim" "$reset" "$cyan" "$common_branch" "$reset"
fi
if [[ -n $common_jira ]]; then
  local hdr_link=''
  if [[ -t 1 ]]; then
    hdr_link=$(printf '\e]8;;%s\e\\%s%s%s\e]8;;\e\\' \
                 "https://storytel.atlassian.net/browse/${common_jira}" \
                 "$blue" "$common_jira" "$reset")
  else
    hdr_link=$common_jira
  fi
  local hdr_summary=${jira_summary[$common_jira]:-}
  printf '%sjira:%s   ' "$dim" "$reset"
  print -rn -- "$hdr_link"
  [[ -n $hdr_summary ]] && printf '  %s%s%s' "$dim" "$hdr_summary" "$reset"
  print
fi
print

if (( ${#render_rows} == 0 )); then
  if (( ${#members} == 1 )); then
    printf '%sclean and in sync%s\n' "$dim" "$reset"
  else
    printf '%sall %d repos clean and in sync%s\n' "$dim" "${#members}" "$reset"
  fi
  return 0
fi

# The base ref is shown in the AHEAD/BEHIND header rather than per row: every
# member of a collection shares a default branch, and repeating "origin/main"
# N times costs a column for no information. A row whose base differs from the
# majority is annotated inline instead.
local -A base_count
local r_base=''
for row in "${render_rows[@]}"; do
  local -a rf=()
  rf=("${(@s:	:)row}")
  r_base=${rf[3]}
  base_count[$r_base]=$(( ${base_count[$r_base]:-0} + 1 ))
done

local bk=''
local -i best=0
for bk in ${(k)base_count}; do
  if (( base_count[$bk] > best )); then
    best=${base_count[$bk]}
    common_base=$bk
  fi
done

# Column widths, measured over the rows actually being rendered.
local -i w_name=4 w_branch=6
for row in "${render_rows[@]}"; do
  local -a rf=()
  rf=("${(@s:	:)row}")
  (( ${#rf[1]} > w_name   )) && w_name=${#rf[1]}
  (( ${#rf[2]} > w_branch )) && w_branch=${#rf[2]}
done

# Keep the branch column from swallowing the terminal. Collections use long
# branch names (DATA-2770/feat/widen_gar_cleanup_policies), so cap and
# ellipsize rather than wrapping the table.
local -i w_branch_max=38
(( w_branch > w_branch_max )) && w_branch=$w_branch_max

local -i show_branch=1 show_jira=1
[[ -n $common_branch ]] && show_branch=0
[[ -n $common_jira   ]] && show_jira=0
(( want_jira )) || show_jira=0

# Drop the JIRA column when no repo resolved a key: a full column of "-" is
# noise. (The uniform-value hoist above only fires on a shared non-empty
# key, so an all-empty collection would otherwise still render the column.)
if (( show_jira )); then
  local -i any_jira=0
  for row in "${render_rows[@]}"; do
    local -a jrf=()
    jrf=("${(@s:	:)row}")
    [[ -n ${jira_of[${jrf[1]}]:-} ]] && { any_jira=1; break; }
  done
  (( any_jira )) || show_jira=0
fi

# LOCAL column width, measured over the rendered cells ("clean" is the
# fallback text, so it sets the floor).
local -i w_local=5
for row in "${render_rows[@]}"; do
  local -a rf=()
  rf=("${(@s:	:)row}")
  (( ${#rf[6]} > w_local )) && w_local=${#rf[6]}
done

# Derive the divergence column width from the header text rather than
# hardcoding it: the cells ("+1 -7", "=", "?") are all narrower than the
# label, so the label sets the width, and deriving it keeps the header and
# the per-row padding below from drifting apart when the label is reworded.
local divergence_label='AHEAD/BEHIND'
local -i w_div=${#divergence_label}

# PR is the last column when JIRA is hidden, so it only needs padding when
# something follows it.
local -i w_pr=7

printf '%s%-*s  ' "$bold" "$w_name" "REPO"
(( show_branch )) && printf '%-*s  ' "$w_branch" "BRANCH"
printf '%-*s  %-*s  ' "$w_div" "$divergence_label" "$w_local" "LOCAL"
if (( show_jira )); then
  printf '%-*s  %s' "$w_pr" "PR" "JIRA"
else
  printf '%s' "PR"
fi
printf '%s\n' "$reset"

# Counted over every row, not just the rendered ones: under --changed a
# clean repo can still have a merged PR, and the summary line reports
# against the full member count.
local -i n_with_pr=0
for row in "${rows[@]}"; do
  local -a prf=()
  prf=("${(@s:	:)row}")
  [[ -n ${prf[8]} ]] && (( n_with_pr++ ))
done

for row in "${render_rows[@]}"; do
  local -a rf=()
  rf=("${(@s:	:)row}")
  local r_name=${rf[1]} r_branch=${rf[2]}
  local r_ahead=${rf[4]} r_behind=${rf[5]} r_local=${rf[6]}
  local r_pr=${rf[8]} r_state=${rf[9]} r_url=${rf[10]}
  r_base=${rf[3]}

  local disp_branch=$r_branch
  if (( ${#disp_branch} > w_branch )); then
    disp_branch="${disp_branch[1,$(( w_branch - 1 ))]}…"
  fi

  # Divergence cell: "=" in sync, "+N" ahead, "-N" behind, "+N -M" both,
  # "?" when the base ref is missing. printf counts escape bytes, so pad
  # against the visible width and emit the colored string separately.
  local cell='' cell_plain=''
  if [[ -z $r_ahead || -z $r_behind ]]; then
    cell="${yellow}?${reset}"
    cell_plain='?'
  elif (( r_ahead == 0 && r_behind == 0 )); then
    cell="${dim}=${reset}"
    cell_plain='='
  else
    local -a parts=() parts_plain=()
    (( r_ahead  > 0 )) && { parts+=("${green}+${r_ahead}${reset}"); parts_plain+=("+${r_ahead}"); }
    (( r_behind > 0 )) && { parts+=("${red}-${r_behind}${reset}");  parts_plain+=("-${r_behind}"); }
    cell="${(j: :)parts}"
    cell_plain="${(j: :)parts_plain}"
  fi
  local -i pad_div=$(( w_div - ${#cell_plain} ))
  (( pad_div < 0 )) && pad_div=0

  local local_cell='' local_plain=''
  if [[ -n $r_local ]]; then
    local_plain=$r_local
    local_cell="${yellow}${r_local}${reset}"
  else
    local_plain='clean'
    local_cell="${dim}clean${reset}"
  fi
  local -i pad_local=$(( w_local - ${#local_plain} ))
  (( pad_local < 0 )) && pad_local=0

  # PR cell. The number is an OSC 8 hyperlink so the click target is short
  # and cannot wrap; state colors it (open green, merged cyan, closed red).
  # A bare URL here would wrap and silently open a truncated page — see the
  # OSC 8 rule in zsh/AGENTS.md.
  local pr_cell='' pr_plain=''
  if [[ -n $r_pr ]]; then
    pr_plain="#${r_pr}"
    local pr_color=$dim
    case ${(L)r_state} in
      open)   pr_color=$green ;;
      merged) pr_color=$cyan ;;
      closed) pr_color=$red ;;
    esac
    if [[ -n $r_url && -t 1 ]]; then
      pr_cell=$(printf '\e]8;;%s\e\\%s%s%s\e]8;;\e\\' "$r_url" "$pr_color" "$pr_plain" "$reset")
    else
      pr_cell="${pr_color}${pr_plain}${reset}"
    fi
  else
    pr_plain='-'
    pr_cell="${dim}-${reset}"
  fi
  local -i pad_pr=$(( w_pr - ${#pr_plain} ))
  (( pad_pr < 0 )) && pad_pr=0

  # JIRA cell: key as an OSC 8 link, summary as plain text beside it. Only
  # the key is linked — a short click target cannot wrap, and the summary is
  # then free to be any length.
  local jira_cell=''
  local jkey=${jira_of[$r_name]:-}
  if [[ -n $jkey ]]; then
    if [[ -t 1 ]]; then
      jira_cell=$(printf '\e]8;;%s\e\\%s%s%s\e]8;;\e\\' \
                    "https://storytel.atlassian.net/browse/${jkey}" "$blue" "$jkey" "$reset")
    else
      jira_cell="$jkey"
    fi
    local jsummary=${jira_summary[$jkey]:-}
    [[ -n $jsummary ]] && jira_cell+="  ${dim}${jsummary}${reset}"
  else
    jira_cell="${dim}-${reset}"
  fi

  # A row on a non-majority base gets the base spelled out after it.
  local base_note=''
  [[ -n $common_base && $r_base != $common_base ]] && base_note=" ${dim}(vs ${r_base})${reset}"

  printf '%-*s  ' "$w_name" "$r_name"
  (( show_branch )) && printf '%s%-*s%s  ' "$cyan" "$w_branch" "$disp_branch" "$reset"
  print -rn -- "$cell"
  printf '%*s  ' "$pad_div" ''
  print -rn -- "$local_cell"
  printf '%*s  ' "$pad_local" ''
  print -rn -- "$pr_cell"
  if (( show_jira )); then
    printf '%*s  ' "$pad_pr" ''
    print -rn -- "$jira_cell"
  fi
  print -r -- "$base_note"
done

# ---------------------------------------------------------------------------
# Unchanged roll-up (--changed only)
#
# Strip the longest "-"-delimited prefix shared by EVERY member (e.g.
# "data-platform-") so the line stays short. Computed across all members,
# not just the unchanged ones, so the abbreviation does not shift depending
# on which repos happen to be dirty. Same approach as wt-collection-preview.
#
# A prefix is only stripped when it is long enough to be boilerplate: at
# least 8 characters AND spanning 2+ "-"-delimited segments. "data-platform-"
# (14 chars, 2 segments) qualifies; "repo-" (5 chars, 1 segment) does not —
# stripping the latter turns repo-one/repo-two/repo-three into
# "one, two, three", which is shorter but no longer reads as repo names.
# The remainder must also keep 3+ characters on every name.
# ---------------------------------------------------------------------------

if (( changed_only )) && (( ${#unchanged_names} )); then
  local prefix=''
  local -a seg_parts=()
  seg_parts=("${(@s:-:)${members[1]:t}}")
  local -i si=0
  local cand=''
  for (( si = ${#seg_parts} - 1; si >= 1; si-- )); do
    cand="${(j:-:)seg_parts[1,$si]}-"
    local -i ok=1
    local mm=''
    for mm in "${members[@]}"; do
      [[ ${mm:t} == ${cand}* ]] || { ok=0; break; }
    done
    (( ok )) && { prefix=$cand; break; }
  done

  # Reject a prefix that is too short to be boilerplate, measured both in
  # characters and in "-"-delimited segments.
  if [[ -n $prefix ]]; then
    local -a pseg=()
    pseg=("${(@s:-:)${prefix%-}}")
    if (( ${#prefix} < 8 || ${#pseg} < 2 )); then
      prefix=''
    fi
  fi

  local -i all_prefixed=0
  local nm=''
  if [[ -n $prefix ]]; then
    all_prefixed=1
    for nm in "${unchanged_names[@]}"; do
      [[ $nm == ${prefix}* ]] || { all_prefixed=0; break; }
      (( ${#nm} - ${#prefix} >= 3 )) || { all_prefixed=0; break; }
    done
  fi

  local -a short_names=()
  for nm in "${unchanged_names[@]}"; do
    if (( all_prefixed )); then
      short_names+=("${nm#$prefix}")
    else
      short_names+=("$nm")
    fi
  done

  print
  printf '%sunchanged: %s%s\n' "$dim" "${(j:, :)short_names}" "$reset"
fi

print
local -a summary_bits=()
summary_bits+=("${n_changed} of ${#members} ${repo_word} with changes")
(( want_pr )) && summary_bits+=("${n_with_pr} with a PR")
printf '%s%s%s\n' "$dim" "${(j:, :)summary_bits}" "$reset"
